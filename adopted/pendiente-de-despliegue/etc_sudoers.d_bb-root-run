# /etc/sudoers.d/bb-root-run -- voto de Luis 2026-10-14 ("scripts sellados por hash").
# Argumento como REGEX de sudo (sudo >= 1.9.10; esta maquina tiene 1.9.15p5): empieza en ^
# y acaba en $, y la clase no admite espacio ni '/', asi que sudo solo deja pasar UN
# argumento sin rutas. El glob '*' de sudoers NO serviria: casa espacios y '/'.
# El runner repite la guarda por su cuenta (exactamente un argumento, ^[a-z0-9][a-z0-9-]{0,40}$).
lcasarin ALL=(root) NOPASSWD: /usr/local/sbin/bb-root-run ^[a-z0-9][a-z0-9-]*$
