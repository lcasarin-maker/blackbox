[Unit]
Description=blackbox: veredicto de causa del reinicio anterior (una fila por boot, INDETERMINADO por defecto)
Documentation=file:%h/projects/blackbox/tools/reboot_verdict.py

[Service]
Type=oneshot
WorkingDirectory=%h/projects/blackbox
# Antes de cada veredicto (a los 20 s y a los 3 min), lo que el veredicto necesita fresco:
# 1) el resumen del arranque anterior de las marcas de bb-etapa@ (tools/etapas_arranque.py; rc 1 si este arranque aun
#    no llego a multi-user, rc 2 sin etapas.jsonl: ninguno debe impedir el veredicto, de ahi el "-");
# 2) las series del testigo externo traidas por scp a $BLACKBOX_DATA/externo/testigo/ (observador_ping --trae-testigo;
#    sin externo/testigo.json sale NOT_COLLECTED rc 1 sin tocar nada, y el veredicto declara la fuente que falto).
ExecStartPre=-/usr/bin/python3 -m tools.etapas_arranque
ExecStartPre=-/usr/bin/python3 -m tools.observador_ping --trae-testigo
# --pendientes: cada boot de `journalctl --list-boots` sin fila en reboots.jsonl, menos el vivo; idempotente
# por boot_id y append-only, asi que correr a los 20 s y otra vez a los 3 min no duplica filas.
ExecStart=/usr/bin/python3 -m tools.reboot_verdict --pendientes --escribe
Nice=19
IOSchedulingClass=idle
# La lectura de telemetria recorre un archivo de ~150 MB: 7 s medidos para 10 boots. TimeoutStartSec cubre tambien
# los ExecStartPre: el scp del testigo tiene su propio tope de 120 s (observador_ping.trae_testigo).
TimeoutStartSec=300
