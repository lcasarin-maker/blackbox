#!/bin/sh
# rojo -- boton rojo (docs/BOTON-ROJO.md). Se instala como /usr/local/sbin/rojo:
#   sudo rojo            suspende todo lo que no es KEEP
#   sudo rojo seco       plan, sin tocar nada
#   sudo rojo estado     que esta suspendido
#   sudo rojo restaura   deshace (motor: sudo rojo restaura todo si)
# Ejecuta la COPIA root-owned del nucleo, nunca el repo: un root no corre codigo
# de un directorio que un usuario puede escribir. -I: sin PYTHON*, sin site de
# usuario y sin el directorio actual en sys.path.
exec /usr/bin/python3 -I /usr/local/lib/blackbox/boton_rojo.py "$@"
