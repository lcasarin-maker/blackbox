#!/bin/bash
# Vigilante del motor de inferencia local. Absorbido de Declutter (DECL-CORE-322,
# /home/lcasarin/data/declutter_corpus/vigilante_servidor.sh) el 2026-10-10.
#
# systemd (ai-nemotron.service, Restart=on-failure) ya levanta el servidor cuando
# muere; este script cubre lo que systemd no ve: la unidad sigue activa y
# /v1/models responde 200, pero el chat no vuelve. Medido el 2026-10-09: de 03:21
# a 06:52 sin una sola ficha, y otras cuatro veces ese dia y el siguiente.
# Prueba una llamada minima de chat; tras UMBRAL fallos seguidos reinicia la
# unidad. No actua durante GRACIA_S tras un arranque (el modelo tarda ~4 min en
# cargar). Lo dispara ai-nemotron-vigilante.timer cada 2 minutos.
#
# Segundo disparador, desde 2026-10-10 (voto de Luis): un ATASCO por metricas.
# Con peticiones corriendo, ni los tokens generados ni los de prompt avanzan
# entre dos corridas seguidas (ATASCO_N, 2 por defecto = ~4 min). Es la firma de
# los cuelgues medidos y detecta en ~4 min lo que la prueba de chat tarda 9-11.
#
# Tope de reinicios, desde 2026-10-10 (voto de Luis): TOPE por hora, contados con
# tools/workload_restart_policy.py. Agotado, deja de reiniciar, guarda un snapshot,
# escribe motor_alerta.json, avisa al escritorio y `bb status` marca FALTA hasta
# que el motor vuelva a responder. Un reinicio no arregla la causa (un bug CUDA):
# el tope corta el bucle y obliga a que alguien mire. Si la politica misma no
# puede correr, REINICIA igual y lo registra: el instrumento no debe tumbar el
# servicio que cuida.
#
# Cada reinicio queda en vigilante_motor.log con la palabra REINICIA: `bb scan`
# (tools/motor_caidas.py) cuenta esas lineas como cuelgues del motor.
DATA="${BLACKBOX_DATA:-$HOME/.local/share/blackbox}"
URL=${VIGILANTE_URL:-http://localhost:8000/v1}
UNIDAD=${VIGILANTE_UNIDAD:-ai-nemotron.service}
S=${VIGILANTE_SALIDAS:-$DATA}
UMBRAL=${VIGILANTE_UMBRAL:-3}
GRACIA_S=${VIGILANTE_GRACIA_S:-600}
ESPERA_CHAT_S=${VIGILANTE_ESPERA_CHAT_S:-120}
MODELO=${VIGILANTE_MODELO:-nemotron-local}
METRICAS=${VIGILANTE_METRICAS:-http://localhost:8000/metrics}
ATASCO_N=${VIGILANTE_ATASCO_N:-2}
TOPE=${VIGILANTE_TOPE:-3}
RAIZ=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
SNAPSHOT_CMD=${VIGILANTE_SNAPSHOT_CMD:-$RAIZ/bin/bb snapshot}
mkdir -p "$S"
ESTADO=$S/vigilante_motor.fallos
ESTADO_ATASCO=$S/vigilante_motor.atasco
PRESUPUESTO=$S/vigilante_motor.presupuesto
ALERTA=$S/motor_alerta.json
LOG=$S/vigilante_motor.log
reg() { echo "[$(date '+%F %T')] $*" >> "$LOG"; }

arranque=$(systemctl --user show "$UNIDAD" -p ExecMainStartTimestamp --value)
if [ "$(systemctl --user show "$UNIDAD" -p ActiveState --value)" != active ] || [ -z "$arranque" ]; then
  reg "unidad $UNIDAD no activa: la recupera systemd"; echo 0 > "$ESTADO"; exit 0
fi
edad=$(( $(date +%s) - $(date -d "$arranque" +%s) ))
[ "$edad" -lt "$GRACIA_S" ] && { echo 0 > "$ESTADO"; exit 0; }

reinicia() { # motivo
  if [ -n "$VIGILANTE_SIMULA" ]; then reg "SIMULACRO: reiniciaria $UNIDAD ($1)"; return; fi
  local decision rc
  decision=$(python3 "$RAIZ/tools/workload_restart_policy.py" --state "$PRESUPUESTO" \
    --workload-id "$UNIDAD" --limit "$TOPE" --window-seconds 3600); rc=$?
  case $rc in
    1) tope_agotado "$1"; return ;;
    0) ;;
    *) reg "presupuesto de reinicios ilegible (rc=$rc): reinicia igual -- $decision" ;;
  esac
  reg "REINICIA $UNIDAD ($1)"; systemctl --user restart "$UNIDAD"
}

tope_agotado() { # motivo
  reg "TOPE: $TOPE reinicios en la ultima hora; NO reinicia ($1)"
  [ -e "$ALERTA" ] && return          # ya avisado: no repetir snapshot ni aviso
  printf '{"ts": "%s", "unidad": "%s", "motivo": "%s", "tope_por_hora": %s}\n' \
    "$(date -Is)" "$UNIDAD" "$1" "$TOPE" > "$ALERTA"
  timeout 180 $SNAPSHOT_CMD "motor: tope de reinicios agotado" >> "$LOG" 2>&1 || reg "snapshot del tope no completo"
  if command -v notify-send >/dev/null 2>&1; then
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus" \
      notify-send -u critical "Motor LLM caido" "Tope de $TOPE reinicios/hora agotado ($1). Ver bb status." 2>>"$LOG" || true
  fi
}

alerta_resuelta() {
  [ -e "$ALERTA" ] || return 0
  mv "$ALERTA" "$S/motor_alerta.resuelta.$(date +%s).json" && reg "alerta del tope resuelta: el motor responde"
}

# run>0 y contadores planos entre corridas. Sin metricas legibles no se cuenta
# nada: ahi manda la prueba de chat de abajo.
m=$(curl -s -m 5 "$METRICAS" 2>/dev/null | awk '
  /^vllm:num_requests_running\{/ { run = $2 }
  /^vllm:generation_tokens_total\{/ { gen += $2 }
  /^vllm:prompt_tokens_total\{/ { pro += $2 }
  END { if (run != "") printf "%.0f %.0f %.0f", run, gen, pro }')
if [ -n "$m" ]; then
  read -r run gen pro <<<"$m"
  read -r pgen ppro natasco 2>/dev/null < "$ESTADO_ATASCO" || { pgen=""; ppro=""; natasco=0; }
  if [ "$run" -gt 0 ] && [ "$gen" = "$pgen" ] && [ "$pro" = "$ppro" ]; then
    natasco=$((natasco + 1))
    reg "atasco por metricas: $run peticiones corriendo y 0 tokens avanzados; $natasco de $ATASCO_N"
  else
    natasco=0
  fi
  echo "$gen $pro $natasco" > "$ESTADO_ATASCO"
  if [ "$natasco" -ge "$ATASCO_N" ]; then
    echo "$gen $pro 0" > "$ESTADO_ATASCO"; echo 0 > "$ESTADO"
    reinicia "atasco por metricas"; exit 0
  fi
fi

codigo=$(curl -s -m "$ESPERA_CHAT_S" -o /dev/null -w '%{http_code}' "$URL/chat/completions" \
  -H 'Content-Type: application/json' \
  -d "{\"model\":\"$MODELO\",\"messages\":[{\"role\":\"user\",\"content\":\"ok\"}],\"max_tokens\":1}")
if [ "$codigo" = 200 ]; then
  [ "$(cat "$ESTADO" 2>/dev/null || echo 0)" != 0 ] && reg "chat responde de nuevo"
  echo 0 > "$ESTADO"; alerta_resuelta; exit 0
fi

fallos=$(( $(cat "$ESTADO" 2>/dev/null || echo 0) + 1 )); echo "$fallos" > "$ESTADO"
reg "chat sin respuesta (http=$codigo, espera ${ESPERA_CHAT_S}s) fallo $fallos de $UMBRAL; unidad lleva ${edad}s activa"
if [ "$fallos" -ge "$UMBRAL" ]; then
  echo 0 > "$ESTADO"
  reinicia "chat sin respuesta"
fi
