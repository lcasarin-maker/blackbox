#!/usr/bin/env bash
# Diagnostico de paradas de una unit de usuario: se ejecuta desde ExecStopPost.
#
# Por que existe
# --------------
# bb-guardia-proceso se detuvo dos veces el 2026-10-06 (03:08 y 03:34 CST) y ningun
# registro dijo quien mando la senal. systemd solo anota "code=killed, status=15/TERM"
# o "status=9/KILL". bb ya persiste las senales con su emisor en sigterm.jsonl (regla audit
# blackbox_sigterm/blackbox_sigkill), pero sin este script nadie mira ese registro en el momento de la parada.
#
# Uso (lo llama systemd): bb-parada-diagnostico <unit> <EXIT_STATUS> <SERVICE_RESULT>
# Escribe en $DATA/paradas.log. Sale 0 siempre: un diagnostico no debe cambiar la parada.
set -u
unidad="${1:?falta el nombre de la unit}"
estado="${2:-?}"
resultado="${3:-?}"
data="${BLACKBOX_DATA:-$HOME/.local/share/blackbox}"
mkdir -p "$data"
log="$data/paradas.log"
ahora=$(date '+%Y-%m-%d %H:%M:%S')
desde=$(date -d '-3 min' '+%Y-%m-%d %H:%M:%S')

{
  echo "=== $ahora unit=$unidad exit_status=$estado service_result=$resultado"
  echo "--- journal de la unit (3 min):"
  journalctl --user -u "$unidad" --since "$desde" --no-pager 2>&1 | tail -n 15
  echo "--- senales registradas por bb (sigterm.jsonl, ultimos 10 min): emisor y senal:"
  # La regla audit instalada usa las claves blackbox_sigterm/blackbox_sigkill y ausearch pide root; bb ya las persiste en
  # un archivo del usuario (bin/bb sigterm_persist), asi que se lee ese.
  desde_ts=$(date -d '-10 min' '+%s')
  tail -n 3000 "$data/sigterm.jsonl" 2>/dev/null \
    | awk -v t="$desde_ts" 'match($0, /"ts":[0-9]+/) { if (substr($0, RSTART + 5, RLENGTH - 5) + 0 >= t) print }' \
    | cut -c1-400 | tail -n 20
  echo "--- kernel (3 min), OOM o kill:"
  journalctl -k --since "$desde" --no-pager 2>&1 | grep -iE 'killed process|oom-kill|out of memory: kill' | tail -n 5
  echo
} >> "$log" 2>&1
exit 0
