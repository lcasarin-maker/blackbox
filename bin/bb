#!/usr/bin/env bash
# shellcheck disable=SC2319
# SC2319 sigue disparando en cmd_status incluso capturando "$?" en la MISMA
# linea que la condicion ("[ ... ]; ok=$?") -- shellcheck no distingue esa
# forma seria de la version bare que de verdad era fragil (chk "..." $?,
# corregida 2026-09-11 tras un hallazgo real de shellcheck). No hay comando
# intermedio que pueda pisar "$ok" entre la condicion y su captura: es un
# falso positivo del lint sobre un patron ya endurecido, no una desactivacion
# para esconder el problema original.
# blackbox -- caja negra de esta maquina.
# Registra continuamente lo que hace falta para diagnosticar DESPUES de un fallo:
# cuelgues, crashes, OOM (RAM y GPU), procesos que desaparecen.
#
# Disenado sobre el incidente del 2026-09-07 (claude-desktop colgada sin renderer,
# sin volcado, sin OOM registrado): las senales que faltaron estan en `bb scan`.
#
# Sin dependencias fuera de lo ya instalado: coreutils, procps, systemd, nvidia-smi.

set -uo pipefail

DATA="${BLACKBOX_DATA:-$HOME/.local/share/blackbox}"
SAMPLES="$DATA/samples"
SNAPS="$DATA/snapshots"
RETAIN_DAYS="${BLACKBOX_RETAIN_DAYS:-14}"
ATLAS_TELEMETRY="${ATLAS_TELEMETRY:-$HOME/projects/Atlas/logs/atom_gpu_telemetry.jsonl}"

mkdir -p "$SAMPLES" "$SNAPS"
# $DATA guarda command-lines completas de procesos ajenos (bb who/scan/sample)
# -- no depender del umask heredado para su permiso. chmod en cada arranque,
# no solo al crear: un $DATA ya existente de antes de este endurecimiento
# (verificado 2026-09-11: 775 en esta maquina, heredado de umask 002) no lo
# arregla un `mkdir -p` idempotente. 700 en el directorio TOPE ya bloquea el
# acceso a samples/ y snapshots/ debajo, aunque esos conserven su propio modo.
chmod 700 "$DATA" 2>/dev/null || true

# ---------------------------------------------------------------- utilidades

# Contador de comprobaciones que NO se pudieron correr. La politica de reporte
# es que un informe con could_not_run > 0 no es un informe limpio, por muchas
# filas que pasen -- asi que se imprime al lado de lo que si corrio.
CNR=0
CNR_LIST=""
cannot_run() { CNR=$((CNR + 1)); CNR_LIST="${CNR_LIST}  - $1: $2"$'\n'; }

have() { command -v "$1" >/dev/null 2>&1; }

# ------------------------------------------------------------ fuentes de dato

# Memoria GPU. En el GB10 de esta maquina `--query-gpu=memory.used` devuelve
# N/A (memoria unificada), asi que el agregado se obtiene sumando los procesos
# de computo. Comprobado 2026-09-07: query-gpu -> [N/A]; query-compute-apps ->
# vLLM 33813 MiB, aequitas_os 10251 MiB, rustdesk 237 MiB.
gpu_mem_mib() {
  have nvidia-smi || { echo ""; return 1; }
  nvidia-smi --query-compute-apps=used_memory --format=csv,noheader,nounits 2>/dev/null |
    awk '{s+=$1} END{if(NR==0) print 0; else print s}'
}

gpu_procs() {
  have nvidia-smi || return 1
  nvidia-smi --query-compute-apps=pid,process_name,used_memory \
    --format=csv,noheader,nounits 2>/dev/null
}

gpu_stat() { # temp,util,power
  have nvidia-smi || { echo ",,"; return 1; }
  nvidia-smi --query-gpu=temperature.gpu,utilization.gpu,power.draw \
    --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' '
}

# Razones de throttle CON NOMBRE, mas sus contadores acumulados de por vida.
# Verificado 2026-09-11 en este GB10 (nvidia-smi 580.173.02): `-q -d
# PERFORMANCE` distingue SW Power Cap de HW/SW Thermal Slowdown y de HW Power
# Brake Slowdown -- hasta hoy bin/bb solo veia un bit "throttle" sin decir
# CUAL de esas causas era, y HARVEST-364166/374274/376039 son justo reportes
# donde esa distincion importaba. Los contadores son acumulados desde el
# ultimo reinicio del driver, no una muestra de la ventana de `bb scan` --
# ninguna fuente existente en este repo los leia. Confirmado NO aplicable en
# este hardware, mismo dia: ECC, PAGE_RETIREMENT y ROW_REMAPPER devuelven
# N/A via `-q -d ECC`/`PAGE_RETIREMENT`/`ROW_REMAPPER` (GB10 no los expone).
gpu_perf_raw() {
  have nvidia-smi || return 1
  timeout 5 nvidia-smi -q -d PERFORMANCE 2>/dev/null
}

gpu_throttle_activas() { # stdin: gpu_perf_raw -> una razon "Active" ahora mismo por linea
  awk '
    /Clocks Event Reasons Counters/ { exit }
    /Clocks Event Reasons *$/ { en=1; next }
    en && / : *Active$/ {
      line=$0
      sub(/ *: *Active$/, "", line)
      gsub(/^ +/, "", line)
      print line
    }'
}

gpu_throttle_contadores() { # stdin: gpu_perf_raw -> "razon  Ns" por cada contador > 0
  awk -F': *' '
    /Clocks Event Reasons Counters/ { en=1; next }
    /Sparse Operation Mode/ { exit }
    en && /us *$/ {
      label=$1; gsub(/^ +| +$/, "", label)
      val=$2+0
      if (val > 0) printf "    %-24s %d s\n", label, int(val/1000000)
    }'
}

# MemFree ademas de MemAvailable. En el incidente del 07-sep MemAvailable decia
# 28 GB mientras MemFree estaba en 4.6 GB: mirar solo el primero oculta la
# presion real, y con memoria unificada la GPU compite por esa misma RAM.
meminfo_kb() { awk -v k="$1" '$1==k":"{print $2}' /proc/meminfo; }

# Committed_AS: memoria que los procesos han PEDIDO, aunque no la hayan tocado.
# Es un indicador ADELANTADO y por eso se anadio el 2026-09-24. En el cuarto
# congelamiento salto de 48.3 GB a 126.2 GB en UN minuto -- 33.64 % -> 87.81 %
# de compromiso -- y lo hizo ANTES de que la memoria usada subiera y DOS minutos
# antes de que PSI se moviera. La muestra registraba mem_free y mem_avail, que
# no se enteraron hasta que el dano ya estaba hecho.
compromiso_pct() { # imprime el % de RAM+swap ya comprometido
  awk '/^MemTotal:/{mt=$2} /^SwapTotal:/{st=$2} /^Committed_AS:/{c=$2}
       END{ if (mt+st > 0) printf "%.2f", c*100/(mt+st); else print 0 }' /proc/meminfo
}

# Memoria que NADIE reclama: ni libre, ni cache, ni de un proceso, ni de un
# contexto CUDA. Se anadio el 2026-09-24 porque en el cuarto congelamiento
# desaparecieron 21 GB y NINGUN instrumento los vio: `nvidia-smi` por proceso no
# se movio (37.6 GB antes y despues) y la suma de RSS solo subio 2.1 GB.
#
# CONTROL corrido antes de escribirlo: con 4 GiB de CUDA tomados por torch --
# memoria que SI tiene dueno -- el residuo no se mueve (delta +0.0 GB). O sea
# que es insensible a lo atribuible, que es lo que lo hace util: cuando se
# mueva, lo que lo movio no tiene dueno.
#
# El valor absoluto es negativo (~-4 GB) por doble conteo de paginas
# compartidas entre procesos. Lo que importa es el DELTA, no el nivel.
residuo_mb() { # MemTotal - todo lo reclamado, en MiB
  local rss gpu
  rss=$(ps -eo rss= 2>/dev/null | awk '{s+=$1} END{print s+0}')
  gpu=$(gpu_mem_mib 2>/dev/null); gpu=$(( ${gpu:-0} * 1024 ))
  awk -v rss="$rss" -v gpu="$gpu" '
    /^MemTotal:/{mt=$2} /^MemFree:/{mf=$2} /^Buffers:/{bu=$2} /^Cached:/{ca=$2}
    /^SwapCached:/{sc=$2} /^Slab:/{sl=$2} /^KernelStack:/{ks=$2} /^PageTables:/{pt=$2}
    END{ printf "%.0f", (mt - (mf+bu+ca+sc+sl+ks+pt+rss+gpu))/1024 }' /proc/meminfo
}

# PSI (Pressure Stall Information): el porcentaje de tiempo que las tareas
# estuvieron PARADAS esperando un recurso. Es la senal que faltaba el
# 2026-09-07: MemAvailable decia 28 GB mientras MemFree estaba en 4.6 GB, y
# ninguno de los dos dice cuanto se esta sufriendo -- PSI si.
#
# `some` = al menos una tarea parada; `full` = TODAS paradas, o sea trabajo
# util cero. `full` de memoria por encima de cero sostenido es la antesala del
# colapso, y por eso se guardan los dos.
#
# Via: sparkview (foro NVIDIA 366877), ingerido en Atlas
# knowledge/references/forum_nvidia_366877_sparkview-gpu-monitor-tool-with-
# gb10-aware-unified-memory-handling.md -- clasifica LOW/MODERATE/HIGH/CRITICAL
# sobre esta misma fuente para GB10.
psi_campo() { # recurso, linea(some|full), clave(avg10|avg60) -> valor o ""
  awk -v l="$2" -v k="$3" '$1==l { for (i=2; i<=NF; i++) {
      split($i, kv, "="); if (kv[1]==k) print kv[2] } }' \
    "/proc/pressure/$1" 2>/dev/null
}

# Estado del motor de inferencia. Hueco demostrado el 2026-09-08: el gateway se
# cayo a las 07:41 ("AsyncLLM output_handler failed"), systemd reintento,
# admission_check lo rechazo por falta de memoria y la maquina estuvo sin su LLM
# principal un buen rato -- sin que nada lo reportara. Tener el contenedor "Up"
# no basta: durante la carga del modelo responde el proceso pero no el endpoint.
#
# Mecanismo tomado de thx0701/dgx_spark_status y MiaAI_Lab/sparkDash (ambos
# ingeridos en la KB de Atlas), que vigilan el motor de inferencia junto al
# hardware en vez de dejarlo fuera del cuadro.
GATEWAY_URL="${BLACKBOX_GATEWAY_URL:-http://127.0.0.1:8000/v1/models}"

gateway_modelo() { # -> nombre del modelo servido, o "" si no responde
  have curl || { echo ""; return 1; }
  # grep -o y no sed: el `.*` de sed es codicioso y devolvia el ULTIMO "id" de
  # la respuesta (el `modelperm-...` del bloque de permisos) en vez del primero,
  # que es el nombre del modelo servido.
  timeout 4 curl -s "$GATEWAY_URL" 2>/dev/null |
    grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4
}

# Salud interna del motor de inferencia, de su propio /metrics de Prometheus.
# Saber que el endpoint responde no basta: un gateway con la cola llena o
# expulsando peticiones esta "vivo" y sirviendo mal. `num_preemptions` subiendo
# es presion de KV cache, que en memoria unificada es presion de TODA la
# maquina.
# Via: MiaAI_Lab/sparkDash (KB de Atlas), que lee estas mismas metricas.
GATEWAY_METRICS="${BLACKBOX_GATEWAY_METRICS:-http://127.0.0.1:8000/metrics}"

# Rendimiento REAL, no un benchmark sintetico. La degradacion de inferencia es
# un problema documentado en este hardware (foro NVIDIA 374274, "suddenly much
# lower GPU performance", en la KB de Atlas) y ninguna metrica de ESTADO la ve:
# un gateway a mitad de velocidad responde igual de "vivo".
#
# sparkDash lo resuelve con benchmarks de decode/prefill, pero eso consume GPU y
# compite -- justo el problema que se midio hoy. Mejor: los contadores de tokens
# que vLLM ya lleva del trafico real. Derivando entre dos muestras salen tok/s
# de verdad, con coste cero y sobre trabajo que igualmente iba a ocurrir.
# `errores` distingue "no sirvio" de "sirvio mal".
gateway_salud() { # -> "run,wait,kv_perc,preempt,gen_tokens,prompt_tokens,errores"
  have curl || { echo ""; return 1; }
  timeout 5 curl -s "$GATEWAY_METRICS" 2>/dev/null | awk '
    /^vllm:num_requests_running\{/                    { run = $2 }
    /^vllm:num_requests_waiting\{/                    { wait = $2 }
    /^vllm:kv_cache_usage_perc\{/                     { kv = $2 }
    /^vllm:num_preemptions_total\{/                   { pre = $2 }
    /^vllm:generation_tokens_total\{/                 { gen = $2 }
    /^vllm:prompt_tokens_total\{/                     { pro = $2 }
    /^vllm:request_success_total\{.*reason="error"/   { err = $2 }
    END { if (run == "") exit 1
          printf "%.0f,%.0f,%.3f,%.0f,%.0f,%.0f,%.0f", run, wait, kv, pre, gen, pro, err }'
}

# Uso de disco por particion. Un disco llenandose es un fallo silencioso hasta
# que algo deja de escribir -- y hoy mismo los core dumps se comieron 2.2 GB en
# horas. `df` en el snapshot no bastaba: sin serie no se ve la pendiente.
# Via: thx0701/dgx_spark_status (KB de Atlas), bajado a solo el porcentaje de
# las particiones reales (sin tmpfs ni snaps, que no dicen nada).
disco_pct() { # -> "montaje:pct,montaje:pct"
  df -P -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs 2>/dev/null |
    awk 'NR>1 && $5 ~ /%/ { gsub("%","",$5); printf "%s%s:%s", (n++?",":""), $6, $5 }'
}

# Contenedores: aqui viven el gateway, pgvector, librechat y mongo, y un
# contenedor reiniciandose en bucle es invisible desde `ps`.
# Via: DanTup/dgx_dashboard (KB de Atlas).
docker_estado() { # -> "vivos/total" o ""
  have docker || { echo ""; return 1; }
  local t v
  t=$(timeout 5 docker ps -aq 2>/dev/null | wc -l)
  v=$(timeout 5 docker ps -q 2>/dev/null | wc -l)
  [ "$t" = "0" ] && { echo ""; return 1; }
  echo "$v/$t"
}

# Red y CPU por nucleo. `sar` ya los guarda, pero en OTRO fichero y OTRO
# formato: diagnosticar obliga entonces a cruzar dos series a mano, que es justo
# lo que costo tiempo el 2026-09-08. En la misma linea JSON, ese cruce es un
# grep. Leer /proc cuesta microsegundos, asi que la duplicacion se paga sola.
#
# Se guardan CONTADORES CRUDOS, no tasas: la tasa depende del intervalo y una
# muestra perdida la falsea, mientras que dos contadores siempre dan la verdad
# entre ellos. El analisis deriva la pendiente.
# Via: thx0701/dgx_spark_status y GigCoder/ai_dgxtop (KB de Atlas).
red_bytes() { # -> "iface:rx:tx,..." solo interfaces fisicas con trafico
  awk 'NR>2 { gsub(":","",$1)
      if ($1 != "lo" && $2 > 0) printf "%s%s:%s:%s", (n++?",":""), $1, $2, $10 }' \
    /proc/net/dev 2>/dev/null
}

cpu_jiffies() { # -> "core:idle:total,..." el idle y el total por nucleo
  awk '/^cpu[0-9]/ { t=0; for (i=2; i<=NF; i++) t+=$i
      printf "%s%s:%s:%s", (n++?",":""), $1, $5, t }' /proc/stat 2>/dev/null
}

zombie_count() { ps -eo stat= 2>/dev/null | grep -c '^Z'; }

# Procesos con hijos zombi: en el incidente el zygote dejo de cosechar, y eso
# fue visible mucho antes que el sintoma.
zombie_parents() {
  ps -eo ppid=,stat= 2>/dev/null | awk '$2 ~ /^Z/ {print $1}' | sort | uniq -c | sort -rn
}

# ------------------------------------------------------------------- comandos

# Muestrea SOLO lo que ninguna otra fuente de esta maquina cubre.
# Ya cubierto, y por eso ausente aqui:
#   - GPU, zonas termicas, throttle, clocks, memoria del sistema y procesos de
#     computo -> Atlas/tools/atom_gpu_telemetry.py cada 5s (absorbio a
#     gpu_sampler.sh el 2026-09-07; ver suspended/MANIFIESTO.md)
#   - CPU, memoria, I/O, red, procesos bloqueados -> sar, cada minuto en /var/log/sysstat
#   - alarma de margen de memoria -> monitor_memory.sh cada 5 min
# Lo que NO cubria nada, y es justo lo que fallo el 2026-09-07: el estado de
# las apps de escritorio (renderizadores vivos) y los procesos sin cosechar.
# Umbrales de la rafaga. Ver el bloque que los invoca para su derivacion.
RAFAGA_COMMIT_PTS="${BLACKBOX_RAFAGA_COMMIT_PTS:-10}"   # puntos de %commit en 1 min
RAFAGA_AVAIL_GB="${BLACKBOX_RAFAGA_AVAIL_GB:-8}"        # GB de MemAvailable perdidos
RAFAGA_SEGS="${BLACKBOX_RAFAGA_SEGS:-50}"               # duracion maxima
RAFAGA_PASO="${BLACKBOX_RAFAGA_PASO:-2}"                # cada cuanto

# Muestra LIGERA: solo los contadores baratos. No llama a nvidia-smi ni recorre
# cgroups -- durante una rampa lo que importa es la resolucion temporal, y una
# muestra cara cada 2 s competiria por la misma maquina que se esta cayendo.
muestra_ligera() {
  # Quien CRECIO desde la muestra anterior, con el mismo criterio que la
  # muestra completa: el nivel de VmSize no sirve (un Electron reserva 1.4 TB
  # con MAP_NORESERVE y sale siempre primero), el crecimiento si. Cuesta 12 ms
  # y es lo unico "caro" de la rafaga -- y es justo lo que faltaba: sin esto la
  # rafaga daba resolucion temporal pero no decia QUIEN, que era el hueco
  # declarado al anadirla.
  # Estado PROPIO: si la rafaga pisara $DATA/vsz_prev, la muestra completa
  # compararia contra un mapa de hace 2 s en vez de hace un minuto y su columna
  # `pidio` dejaria de medir lo que dice medir. Detectado al ver la rafaga
  # disparar de verdad el 2026-09-24.
  local tv="" pv="$DATA/vsz_prev_rafaga"
  ps -eo pid=,vsz=,comm= 2>/dev/null | awk '{print $1, $2, $3}' > "$pv.b"
  [ -s "$pv" ] && tv=$(awk 'NR==FNR{v[$1]=$2; next}
      { c = ($1 in v) ? $2 - v[$1] : $2
        if (c > 262144) printf "%s %s %s %s\n", $1, c, $3, (($1 in v) ? 0 : 1) }' \
      "$pv" "$pv.b" 2>/dev/null | sort -k2 -rn | head -3 |
    awk '{printf "%s{\"pid\":%s,\"crecio_kb\":%s,\"comm\":\"%s\",\"nuevo\":%s}", (n++?",":""), $1, $2, $3, ($4==1?"true":"false")}')
  mv -f "$pv.b" "$pv" 2>/dev/null
  printf '{"ts":"%s","burst":true,"mem_free_kb":%s,"mem_avail_kb":%s,"commit_pct":%s,"load1":%s,"pidio":[%s],"psi":{"mem_some":%s,"mem_full":%s}}\n' \
    "$(date +%Y-%m-%dT%H:%M:%S%z)" "$(meminfo_kb MemFree)" "$(meminfo_kb MemAvailable)" \
    "$(compromiso_pct)" "$(awk '{print $1}' /proc/loadavg)" "$tv" \
    "$(psi_campo memory some avg10)" "$(psi_campo memory full avg10)"
}

rafaga_si_hace_falta() { # fichero, mem_avail_kb, commit_pct, psi_full
  local f="$1" ma="$2" cp="$3" psi="$4"
  local prev d_commit d_avail motivo=""
  # La muestra ANTERIOR de verdad: la penultima linea no-rafaga del fichero.
  prev=$(grep -v '"burst":true' "$f" 2>/dev/null | tail -2 | head -1)
  if [ -n "$prev" ]; then
    d_commit=$(printf '%s' "$prev" | sed -n 's/.*"commit_pct":\([0-9.-]*\).*/\1/p')
    d_avail=$(printf '%s' "$prev" | sed -n 's/.*"mem_avail_kb":\([0-9]*\).*/\1/p')
    if [ -n "$d_commit" ] && awk -v a="$cp" -v b="$d_commit" -v u="$RAFAGA_COMMIT_PTS" \
         'BEGIN{exit !(a-b >= u)}'; then
      motivo="commit +$(awk -v a="$cp" -v b="$d_commit" 'BEGIN{printf "%.1f", a-b}') puntos"
    fi
    if [ -z "$motivo" ] && [ -n "$d_avail" ] && awk -v a="$ma" -v b="$d_avail" -v u="$RAFAGA_AVAIL_GB" \
         'BEGIN{exit !((b-a)/1048576 >= u)}'; then
      motivo="mem_avail -$(awk -v a="$ma" -v b="$d_avail" 'BEGIN{printf "%.1f", (b-a)/1048576}') GB"
    fi
  fi
  # PSI dispara con el corte CALIBRADO (UMBRAL=10), no con "distinto de cero".
  # Medido: la linea base de esta maquina es mem_full 0.00 en el 97.99 % de
  # 19696 muestras, o sea que PSI es no-cero el 2 % del tiempo por causas
  # normales -- una asignacion de 3 GiB lo puso en 0.55 y disparo una rafaga
  # inutil el 2026-09-24. 10 es el mismo numero que usan `bb scan`,
  # `bb-usable` y el veto de simplecode, validado contra los cuatro
  # congelamientos con 0 falsos positivos.
  if [ -z "$motivo" ] && awk -v p="${psi:-0}" 'BEGIN{exit !(p >= 10)}'; then
    motivo="psi mem_full=$psi"
  fi
  [ -z "$motivo" ] && return 0

  printf '{"ts":"%s","burst_inicio":true,"motivo":"%s"}\n' \
    "$(date +%Y-%m-%dT%H:%M:%S%z)" "$motivo" >>"$f"
  local fin=$(( $(date +%s) + RAFAGA_SEGS )) tranquilas=0
  while [ "$(date +%s)" -lt "$fin" ]; do
    sleep "$RAFAGA_PASO"
    muestra_ligera >>"$f"
    # Se corta antes si la maquina se calma: tres lecturas seguidas con PSI en
    # cero. Seguir midiendo una caja sana es gastar la maquina que se vigila.
    if awk -v p="$(psi_campo memory full avg10)" 'BEGIN{exit !(p == 0)}'; then
      tranquilas=$((tranquilas + 1))
      [ "$tranquilas" -ge 3 ] && break
    else
      tranquilas=0
    fi
  done
  printf '{"ts":"%s","burst_fin":true}\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" >>"$f"
}

cmd_sample() {
  local ts f
  ts=$(date +%Y-%m-%dT%H:%M:%S%z)
  f="$SAMPLES/$(date +%Y-%m-%d).jsonl"

  local mf ma zc la
  mf=$(meminfo_kb MemFree); ma=$(meminfo_kb MemAvailable)
  local psi_m_some psi_m_full psi_io_some psi_cpu_some
  psi_m_some=$(psi_campo memory some avg10); psi_m_full=$(psi_campo memory full avg10)
  psi_io_some=$(psi_campo io some avg10);    psi_cpu_some=$(psi_campo cpu some avg10)
  local gw dk
  gw=$(gateway_modelo); dk=$(docker_estado)
  local salud disco
  salud=$(gateway_salud); disco=$(disco_pct)
  local red cpuj
  red=$(red_bytes); cpuj=$(cpu_jiffies)
  zc=$(zombie_count)
  la=$(awk '{print $1}' /proc/loadavg)
  local commit_pct residuo
  commit_pct=$(compromiso_pct); residuo=$(residuo_mb)

  # Apps Electron y su cuenta de renderizadores. Un 0 aqui es la firma exacta
  # del cuelgue: proceso principal vivo, ventana en pantalla, UI muerta.
  # Solo apps Chromium/Electron de verdad: se identifican por tener un proceso
  # --type=zygote. Sin ese filtro entraban xdg-desktop-portal y compania, que
  # nunca tienen renderizadores y darian un "0 renderers" falso para siempre.
  local apps
  apps=$(ps -eo pid=,args= 2>/dev/null | awk '
    { exe=$2; if (exe !~ /^\//) next; split(exe,a,"/"); app=a[length(a)] }
    /--type=zygote/   { zyg[app]=1; next }
    /--type=renderer/ { r[app]++;   next }
    /--type=/         { next }
    { main[app]=$1 }
    END { first=1
      for (app in zyg) {
        printf "%s{\"app\":\"%s\",\"pid\":%s,\"renderers\":%d}", (first?"":","), app, (app in main ? main[app] : 0), (app in r ? r[app] : 0)
        first=0 } }')

  # El top lleva la UNIT de cgroup: sin ella la muestra dice que habia un
  # python de 41 GB pero no quien lo lanzo, y esa es justo la pregunta que hubo
  # que contestar a mano tres veces el 2026-09-08. El cgroup sobrevive a que el
  # padre muera y lo adopte init, que es cuando el ppid deja de servir.
  local top
  top=$(ps -eo rss=,pid=,comm= --sort=-rss 2>/dev/null | head -5 |
    while read -r rss pid comm; do
      u=$(sed -n 's/^0::\///p' "/proc/$pid/cgroup" 2>/dev/null | sed 's/.*\///')
      printf '{"rss_kb":%s,"pid":%s,"comm":"%s","unit":"%s"},' "$rss" "$pid" "$comm" "${u:-?}"
    done | sed 's/,$//')

  # QUIEN pidio memoria desde la muestra anterior. Anadido el 2026-09-24
  # porque el cuarto congelamiento se vio venir en Committed_AS (+78 GB en un
  # minuto) y ese contador es un TOTAL: no nombraba a nadie.
  #
  # Se mide el CRECIMIENTO de VmSize, no su nivel, y eso no es un detalle.
  # Medido: reservando 6 GiB con mmap, Committed_AS sube 6.00 GB y la suma de
  # VmSize sube 6.00 GB -- el delta sigue al compromiso 1:1. Pero el NIVEL de
  # VmSize es inservible: los procesos Electron reservan ~1.4 TB virtuales con
  # MAP_NORESERVE, que no cuentan en Committed_AS, asi que un "top 5 por
  # VmSize" son siempre las mismas cinco ventanas de Chromium y no dice nada.
  # Por eso se guarda el mapa anterior y se emite quien CRECIO.
  #
  # Piso de 256 MB: por debajo de eso es ruido de arranque y cierre de procesos
  # normales, y llenaria la muestra de filas sin informacion.
  local topvsz="" prev_vsz="$DATA/vsz_prev"
  ps -eo pid=,vsz=,comm= 2>/dev/null | awk '{print $1, $2, $3}' > "$prev_vsz.new"
  if [ -s "$prev_vsz" ]; then
    # Se recorre el fichero ACTUAL, no el anterior: un proceso que nacio entre
    # las dos muestras no esta en el anterior y de otro modo seria invisible.
    # Para uno nuevo se toma su VmSize entero como crecimiento y se marca
    # "nuevo":true, porque ahi el numero es el que es -- en un Electron recien
    # nacido sera enorme por las reservas MAP_NORESERVE, y quien lea la muestra
    # tiene que poder distinguirlo de un crecimiento real.
    topvsz=$(awk 'NR==FNR{v[$1]=$2; next}
                  { c = ($1 in v) ? $2 - v[$1] : $2
                    if (c > 262144) printf "%s %s %s %s\n", $1, c, $3, (($1 in v) ? 0 : 1) }' \
             "$prev_vsz" "$prev_vsz.new" 2>/dev/null | sort -k2 -rn | head -5 |
      while read -r pid crec comm nuevo; do
        u=$(sed -n 's/^0::\///p' "/proc/$pid/cgroup" 2>/dev/null | sed 's/.*\///')
        printf '{"pid":%s,"crecio_kb":%s,"comm":"%s","unit":"%s","nuevo":%s},' \
          "$pid" "$crec" "$comm" "${u:-?}" "$([ "${nuevo:-0}" = 1 ] && echo true || echo false)"
      done | sed 's/,$//')
  fi
  mv -f "$prev_vsz.new" "$prev_vsz" 2>/dev/null

  # Procesos con memoria de GPU y quien los lanzo. En memoria unificada esto es
  # lo que decide si el gateway puede arrancar: el 2026-09-08 sumaban ~91 GB de
  # los 121 y `admission_check.sh` rechazo los 85 GB que pedia el gateway.
  local gpu
  gpu=$(gpu_procs 2>/dev/null | while IFS=, read -r p n m; do
      p=$(echo "$p" | tr -d ' '); m=$(echo "$m" | tr -d ' ')
      [ -d "/proc/$p" ] || continue
      u=$(sed -n 's/^0::\///p' "/proc/$p/cgroup" 2>/dev/null | sed 's/.*\///')
      printf '{"pid":%s,"mib":%s,"unit":"%s"},' "$p" "${m:-0}" "${u:-?}"
    done | sed 's/,$//')

  # DGX-438: algo mata procesos python de fondo cada 10-15 min con rc=143
  # (SIGTERM) y no se sabe qué. Un SIGTERM ajeno no deja linea en el journal ni
  # core dump, asi que la unica via es notar QUE PID estaba y dejo de estar.
  # Aqui solo se registran; `bb scan` compara muestras consecutivas.
  local pybg
  pybg=$(ps -eo pid=,etimes=,comm= 2>/dev/null |
    awk '$3 ~ /^python/ && $2 > 60 {printf "%s%s", (n++?",":""), $1}')

  printf '{"ts":"%s","mem_free_kb":%s,"mem_avail_kb":%s,"zombies":%s,"load1":%s,"apps":[%s],"top_rss":[%s],"pidio":[%s],"py_bg":[%s],"gpu":[%s],"commit_pct":%s,"residuo_mb":%s,"psi":{"mem_some":%s,"mem_full":%s,"io_some":%s,"cpu_some":%s},"gateway":"%s","docker":"%s","gw_salud":"%s","disco":"%s","red":"%s","cpu_jiffies":"%s"}\n' \
    "$ts" "${mf:-0}" "${ma:-0}" "${zc:-0}" "$la" "$apps" "$top" "$topvsz" "$pybg" "$gpu" \
    "${commit_pct:-0}" "${residuo:-0}" \
    "${psi_m_some:-0}" "${psi_m_full:-0}" "${psi_io_some:-0}" "${psi_cpu_some:-0}" \
    "${gw:-CAIDO}" "${dk:-?}" "${salud:-}" "${disco:-}" "${red:-}" "${cpuj:-}" >>"$f"

  # --- muestreo adaptativo, anadido el 2026-09-24 -------------------------
  # El cuarto congelamiento entero -- de maquina sana a memoria agotada --
  # ocurrio DENTRO de un intervalo de muestreo: 13:58:04 con 58.0 GB libres,
  # 13:59:05 con 36.9 GB. Con una muestra por minuto eso es un escalon entre
  # dos puntos, y no hay forma de saber que lo movio. Cuando algo se mueve
  # rapido hace falta mirar rapido.
  #
  # Los umbrales salen de ese incidente contra la operacion normal, no de una
  # corazonada. En el minuto del colapso: commit_pct +54.17 puntos y mem_avail
  # -21 GB. En operacion normal (sar, horas 13:00-13:58 del mismo dia):
  # commit_pct se mueve menos de 1 punto por minuto y mem_avail 1-3 GB. Los
  # cortes de abajo quedan muy por encima del ruido y muy por debajo del
  # evento.
  rafaga_si_hace_falta "$f" "$ma" "$commit_pct" "$psi_m_full"

  # rotacion: solo se borra lo que ya excedio la retencion declarada
  find "$SAMPLES" -name '*.jsonl' -mtime +"$RETAIN_DAYS" -delete 2>/dev/null
  find "$SNAPS" -maxdepth 1 -type d -mtime +"$RETAIN_DAYS" -exec rm -rf {} + 2>/dev/null
}

cmd_snapshot() {
  local reason="${1:-manual}"
  local d; d="$SNAPS/$(date +%Y-%m-%dT%H%M%S)_${reason//[^a-zA-Z0-9_-]/_}"
  mkdir -p "$d"

  echo "$reason" >"$d/reason.txt"
  date -Iseconds >"$d/when.txt"

  ps -eo pid,ppid,stat,etime,pcpu,pmem,rss,comm,args >"$d/ps.txt" 2>&1
  cp /proc/meminfo "$d/meminfo.txt" 2>/dev/null
  cp /proc/loadavg "$d/loadavg.txt" 2>/dev/null
  free -h >"$d/free.txt" 2>&1
  df -h >"$d/df.txt" 2>&1

  zombie_parents >"$d/zombie-parents.txt" 2>&1
  gpu_procs >"$d/gpu-procs.txt" 2>&1 || echo "nvidia-smi no disponible" >"$d/gpu-procs.txt"
  have nvidia-smi && nvidia-smi -q >"$d/nvidia-smi-q.txt" 2>&1
  have sensors && sensors >"$d/sensors.txt" 2>&1

  # Distingue fallo de MODULO DE KERNEL de fallo de ESPACIO DE USUARIO en un
  # cuelgue de GUI + nvidia-smi (FEATURE-GUI-KERNEL-VS-USERSPACE,
  # HARVEST-366211): si lsmod no lista nvidia, el modulo se descargo o nunca
  # cargo -- eso es kernel. Si SI esta cargado pero gdm no esta activo, el
  # fallo es de espacio de usuario. Es diagnostico puro (lee estado); NO
  # incluye la mitigacion que la ficha original tambien proponia
  # (systemctl set-default/isolate), que es intervencion activa.
  lsmod 2>&1 | grep -i '^nvidia' >"$d/lsmod-nvidia.txt" || echo "(modulo nvidia NO cargado)" >"$d/lsmod-nvidia.txt"
  systemctl status gdm.service --no-pager >"$d/gdm-status.txt" 2>&1

  # ventanas X mapeadas: distingue "app viva sin ventana" de "app muerta"
  if have xprop && [ -n "${DISPLAY:-}" ]; then
    { for w in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | sed 's/.*# //; s/,//g'); do
        echo "$w $(xprop -id "$w" WM_CLASS WM_NAME 2>/dev/null | tr '\n' ' ')"
      done; } >"$d/x-windows.txt" 2>&1
  fi

  journalctl -k -n 500 --no-pager >"$d/journal-kernel.txt" 2>&1
  journalctl -n 1000 --no-pager >"$d/journal-recent.txt" 2>&1

  echo "$d"
}

# ---------------------------------------------------------------------- scan

cmd_scan() {
  local since="${1:-2 hours ago}"
  local since_fmt; since_fmt=$(date -d "$since" '+%Y-%m-%d %H:%M:%S' 2>/dev/null) || {
    echo "fecha invalida: $since" >&2; return 2; }

  echo "== blackbox scan =="
  echo "ventana: desde $since_fmt hasta $(date '+%Y-%m-%d %H:%M:%S')"
  echo "maquina: $(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || echo desconocida)"
  echo

  # --- 1. OOM del kernel y del driver NVIDIA -------------------------------
  echo "-- OOM / fallos de memoria --"
  local koom nvoom
  if journalctl -k -S "$since_fmt" --no-pager >/dev/null 2>&1; then
    # Las lineas NVRM tambien dicen "Out of memory", pero son de la GPU, no de
    # la RAM. Contarlas aqui daba 4 falsos positivos de OOM del kernel.
    koom=$(journalctl -k -S "$since_fmt" --no-pager 2>/dev/null |
      grep -vi 'NVRM' | grep -icE 'oom-kill|oom_reaper|killed process|out of memory' || true)
    nvoom=$(journalctl -k -S "$since_fmt" --no-pager 2>/dev/null |
      grep -icE 'NVRM.*(Out of memory|NV_ERR_NO_MEMORY)' || true)
    echo "  OOM del kernel (RAM):        ${koom:-0}"
    echo "  OOM del driver NVIDIA:       ${nvoom:-0}"
    if [ "${nvoom:-0}" -gt 0 ]; then
      journalctl -k -S "$since_fmt" --no-pager 2>/dev/null |
        grep -iE 'NVRM.*(Out of memory|NV_ERR_NO_MEMORY)' | tail -5 | sed 's/^/    /'
    fi
  else
    cannot_run "OOM del kernel" "journalctl -k no legible (hace falta el grupo adm o systemd-journal)"
    echo "  OOM del kernel:              COULD_NOT_RUN"
  fi
  echo

  # --- 1b. Xid del driver NVIDIA (FEATURE-GPU-XID-DETECTION) ---------------
  # Distinto de la OOM del driver de arriba: Xid es la forma en que el driver
  # reporta fallos de hardware/firmware que NO son falta de memoria (timeout
  # de RPC del GSP, fallo de init de firmware, ECC, etc.). Hasta hoy bin/bb
  # nunca lo grep-eaba -- HARVEST-374016/379959/348223.
  echo "-- Xid del driver NVIDIA --"
  if journalctl -k -S "$since_fmt" --no-pager >/dev/null 2>&1; then
    local nxid
    nxid=$(journalctl -k -S "$since_fmt" --no-pager 2>/dev/null | grep -icE 'NVRM: Xid' || true)
    echo "  eventos Xid:                 ${nxid:-0}"
    if [ "${nxid:-0}" -gt 0 ]; then
      # El codigo va DESPUES de "): ", no despues de "Xid": la direccion PCI
      # (ej. "PCI:0000:01:00") tiene digitos propios que un split ingenuo por
      # "Xid[^0-9]*" confunde con el codigo. Medido: sobre una linea real
      # daba "0000:01:00):" en vez de "79". Se extrae con el patron completo.
      journalctl -k -S "$since_fmt" --no-pager 2>/dev/null | grep -oE 'Xid \(PCI:[^)]*\): [0-9]+' |
        grep -oE '[0-9]+$' | sort | uniq -c | sort -rn |
        awk '{printf "    codigo %-6s x%s\n", $2, $1}'
    fi
  else
    cannot_run "Xid de GPU" "journalctl -k no legible (hace falta el grupo adm o systemd-journal)"
    echo "  eventos Xid:                 COULD_NOT_RUN"
  fi
  # Disponibilidad explicita: distinto de que la telemetria de 5s no haya
  # escrito una muestra -- esto pregunta si nvidia-smi responde AHORA, con
  # limite de tiempo, no si historicamente escribio datos.
  if timeout 5 nvidia-smi >/dev/null 2>&1; then
    echo "  nvidia-smi responde ahora:   si"
    local perf activas
    perf=$(gpu_perf_raw)
    if [ -n "$perf" ]; then
      activas=$(gpu_throttle_activas <<<"$perf")
      if [ -n "$activas" ]; then
        echo "  razones de throttle activas ahora mismo:"
        printf '%s\n' "$activas" | sed 's/^/    /'
      else
        echo "  razones de throttle activas ahora mismo: ninguna"
      fi
    fi
  else
    echo "  nvidia-smi responde ahora:   NO (timeout o error -- ver 'GPU sin responder' abajo)"
  fi
  echo

  # --- 1c. accounting de GPU: procesos ya salidos (FEATURE-GPU-ACCOUNTING) -
  # `--query-compute-apps` (gpu_procs / bb who) solo ve procesos VIVOS ahora
  # mismo -- inutil para la pregunta forense real: quien uso la GPU justo
  # ANTES del fallo, si para cuando se corre `bb scan` ya salio. Accounting
  # mode (root, `sudo ./enable-privileged.sh`) hace que el driver retenga
  # pid/gpu_util/mem_util/memoria_max/tiempo por proceso hasta que se limpian
  # o el driver se reinicia. Verificado 2026-09-11: apagado por defecto, y
  # sin -am 1 `--query-accounted-apps` no da error, da CSV vacio (solo
  # cabecera) -- se distingue leyendo el modo, no adivinando por la salida.
  echo "-- procesos de GPU ya salidos (accounting mode) --"
  if have nvidia-smi; then
    local am
    am=$(timeout 5 nvidia-smi -q -d ACCOUNTING 2>/dev/null |
      awk -F': *' '/Accounting Mode/{print $2; exit}')
    if [ "$am" = "Enabled" ]; then
      local acc
      acc=$(nvidia-smi --query-accounted-apps=pid,gpu_utilization,mem_utilization,max_memory_usage,time \
        --format=csv,noheader 2>/dev/null)
      if [ -n "$acc" ]; then
        echo "  pid, gpu_util%, mem_util%, memoria_max_MiB, tiempo_ms"
        printf '%s\n' "$acc" | sed 's/^/    /'
      else
        echo "  accounting mode armado, sin procesos registrados todavia"
      fi
    else
      cannot_run "accounting de GPU" "accounting mode apagado -- sudo ./enable-privileged.sh lo arma"
      echo "  accounting mode:             COULD_NOT_RUN (apagado)"
    fi
  else
    cannot_run "accounting de GPU" "nvidia-smi no disponible"
    echo "  accounting mode:             COULD_NOT_RUN"
  fi
  echo

  # --- 1d. NVIDIA Field Diagnostic (dgx-spark-fieldiag), si corrio ---------
  # blackbox NO lo instala ni lo corre: es DISRUPTIVO por diseno (mata la
  # GUI, para docker, 30-40 min) y pensado para pre-chequeo de RMA, no para
  # correr junto al uso normal. Si el operador YA lo corrio, se lee su
  # veredicto en vez de duplicarlo. Verificado 2026-09-12 contra la guia
  # oficial (userguide-dgx-spark-fieldiag.pdf): cada corrida escribe
  # dgx/logs-<yyyymmdd-hhnnss>/summary.json, un array con "Error Code"
  # (000000000000 = sin error), "Test", "Virtual ID" y "Notes" por prueba.
  echo "-- NVIDIA Field Diagnostic (dgx-spark-fieldiag), si corrio en la ventana --"
  local fdroot="/opt/nvidia/dgx-spark-fieldiag/dgx"
  if [ -d "$fdroot" ]; then
    local fdsince fdrun
    fdsince=$(date -d "$since" +%Y%m%d-%H%M%S 2>/dev/null)
    fdrun=$(find "$fdroot" -maxdepth 1 -type d -name 'logs-*' 2>/dev/null |
      awk -F'logs-' -v s="$fdsince" '{if ($2 >= s) print}' | sort | tail -1)
    if [ -n "$fdrun" ] && [ -f "$fdrun/summary.json" ]; then
      echo "  corrida encontrada: $fdrun"
      python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except Exception as e:
    print("  (no se pudo leer summary.json: %s)" % e)
    sys.exit(0)
fallos = [d for d in data
          if str(d.get("Error Code", "")).split("-")[-1] not in ("000000000000", "")]
print("  tests en el resultado: %d" % len(data))
print("  tests con error:       %d" % len(fallos))
for d in fallos[:5]:
    print("    %s (%s): %s" % (d.get("Test"), d.get("Virtual ID"), d.get("Notes")))
' "$fdrun/summary.json"
    else
      echo "  ninguna corrida dentro de esta ventana"
    fi
  else
    echo "  no instalado ($fdroot no existe -- ver 'bb hw' para instalarlo)"
  fi
  echo

  # --- 2. segfaults --------------------------------------------------------
  echo "-- segfaults / traps --"
  local segf
  segf=$(journalctl -S "$since_fmt" --no-pager 2>/dev/null |
    grep -icE 'segfault|general protection|traps:' || true)
  echo "  segfaults registrados:       ${segf:-0}"
  [ "${segf:-0}" -gt 0 ] && journalctl -S "$since_fmt" --no-pager 2>/dev/null |
    grep -iE 'segfault|general protection|traps:' | tail -5 | sed 's/^/    /'
  echo

  # --- 2b. xHCI/USB (FEATURE-USB-XHCI-FORENSICS) ---------------------------
  # Cero cobertura de USB en todo el inventario anterior. Solo se agrega la
  # firma de error INEQUIVOCA del controlador (HC died / "assuming dead" /
  # not responding / timeout / reset forzado -- las dos primeras frases son
  # las que el kernel realmente emite; un primer intento solo buscaba "HC
  # died" y "error" y NO atrapaba "xHCI host controller not responding,
  # assuming dead", la forma mas comun en HARVEST-355453/365609). NO se
  # juzga la velocidad negociada por puerto (480M en esta
  # maquina es, verificado, el root hub USB2 legitimo de cada par xHCI y un
  # dongle Bluetooth que es 480M por diseno; marcarlo como "degradado" sin un
  # manifiesto de que deberia ir mas rapido seria un falso positivo
  # garantizado). El inventario de velocidad por puerto, sin veredicto, vive
  # en `bb hw`.
  echo "-- xHCI / USB --"
  if journalctl -k -S "$since_fmt" --no-pager >/dev/null 2>&1; then
    local nxhci
    nxhci=$(journalctl -k -S "$since_fmt" --no-pager 2>/dev/null |
      grep -icE 'xhci_hcd.*(HC died|assum.*dead|not responding|timeout|reset)' || true)
    echo "  errores xHCI:                ${nxhci:-0}"
    [ "${nxhci:-0}" -gt 0 ] && journalctl -k -S "$since_fmt" --no-pager 2>/dev/null |
      grep -iE 'xhci_hcd.*(HC died|assum.*dead|not responding|timeout|reset)' | tail -5 | sed 's/^/    /'
  else
    cannot_run "xHCI/USB" "journalctl -k no legible (hace falta el grupo adm o systemd-journal)"
    echo "  errores xHCI:                COULD_NOT_RUN"
  fi
  echo

  # --- 3. core dumps -------------------------------------------------------
  echo "-- core dumps --"
  if have coredumpctl; then
    local nd
    nd=$(coredumpctl list --since "$since_fmt" --no-pager 2>/dev/null | grep -cE '^(Mon|Tue|Wed|Thu|Fri|Sat|Sun|[0-9])' || true)
    echo "  volcados capturados:         ${nd:-0}"
    # Un binario que aparece cientos de veces no son cientos de hallazgos: es
    # UN bucle de crash, y su ruido entierra el volcado que si importa. Se
    # agrupa por ejecutable y se separa el bucle del resto.
    # Medido 2026-09-08, horas despues de armar la captura: 10880 volcados,
    # 1.7 GB, casi todos de `llama-server --list-devices` abortando ~3 veces
    # por segundo -- un bucle que existia y era invisible.
    if [ "${nd:-0}" -gt 0 ]; then
      # El EXE es la PENULTIMA columna: la ultima es el tamano (p.ej. "151.8K").
      # Agrupar por $NF devolvia tamanos en vez de binarios.
      coredumpctl list --since "$since_fmt" --no-pager 2>/dev/null |
        awk 'NF>5 && $(NF-1) ~ /\// {print $(NF-1)}' | sort | uniq -c | sort -rn |
        awk '{ if ($1 >= 20) printf "    BUCLE  %6d x %s\n", $1, $2;
               else printf "    %6d x %s\n", $1, $2 }' | head -8
      local disco
      disco=$(du -sh /var/lib/systemd/coredump 2>/dev/null | cut -f1)
      [ -n "$disco" ] && echo "  espacio ocupado:             $disco"
    fi
  else
    cannot_run "core dumps" "systemd-coredump no instalado -- corre enable-privileged.sh"
    echo "  volcados capturados:         COULD_NOT_RUN"
  fi
  local climit; climit=$(ulimit -c)
  if [ "$climit" = "0" ]; then
    echo "  AVISO: ulimit -c = 0 en esta shell, no dejaria volcado"
  fi
  # Lo que de verdad importa no es esta shell, sino si las apps de escritorio
  # que se cuelgan pueden dejar volcado. Un proceso arrancado antes de subir el
  # limite lo conserva a 0 de por vida: instalar systemd-coredump NO lo protege
  # retroactivamente. Medido el 2026-09-07: tras instalarlo, claude-desktop,
  # ChatGPT y gnome-shell seguian los tres con core=0.
  local desprotegidas=0 revisadas=0
  while read -r p; do
    [ -z "$p" ] && continue
    revisadas=$((revisadas + 1))
    [ "$(awk '/Max core file size/{print $5}' "/proc/$p/limits" 2>/dev/null)" = "0" ] &&
      desprotegidas=$((desprotegidas + 1))
  done < <(ps -eo pid=,args= 2>/dev/null | awk '/--type=zygote/{print $1}')
  echo "  apps Electron revisadas:     $revisadas"
  echo "  de ellas SIN volcado (core=0): $desprotegidas"
  if [ "$desprotegidas" -gt 0 ]; then
    echo "    Heredaron el limite viejo. Se arregla relanzandolas desde una"
    echo "    sesion con el limite nuevo, no reinstalando nada."
  fi
  echo "  crashes de apport en /var/crash: $(ls /var/crash/*.crash 2>/dev/null | wc -l)"
  # Volcados de KERNEL via kdump-tools (KDUMP_SKIP_VMCORE=1 en esta maquina:
  # no guarda el vmcore completo -- 121 GB seria impracticable -- pero SI
  # guarda el dmesg del kernel al momento del panic en cada subdirectorio con
  # timestamp). Esto es lo que enable-privileged.sh no cubre: userspace tiene
  # systemd-coredump, kernel tiene esto. FEATURE-KDUMP-PSTORE-PREAPAGADO.
  local nkdump; nkdump=$(find /var/crash -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' 2>/dev/null | wc -l)
  echo "  volcados de kernel (kdump) en /var/crash: ${nkdump:-0}"
  if [ "${nkdump:-0}" -gt 0 ]; then
    find /var/crash -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' 2>/dev/null | sort | tail -3 |
      while read -r d; do echo "    $d/$(ls "$d" 2>/dev/null | tr '\n' ' ')"; done
  fi
  echo

  # --- 4. zombis y procesos sin cosechar -----------------------------------
  echo "-- zombis --"
  local zc; zc=$(zombie_count)
  echo "  zombis ahora mismo:          ${zc:-0}"
  if [ "${zc:-0}" -gt 0 ]; then
    echo "  padres que no cosechan:"
    zombie_parents | head -5 | while read -r n ppid; do
      echo "    ppid=$ppid ($n zombis): $(ps -o comm= -p "$ppid" 2>/dev/null || echo '<padre muerto>')"
    done
  fi
  echo

  # --- 5. apps Electron: viva pero sin renderer ----------------------------
  # La firma exacta del cuelgue del 2026-09-07: proceso principal vivo,
  # ventana mapeada, cero procesos --type=renderer.
  echo "-- apps Electron sin renderer (proceso vivo, UI muerta) --"
  local found=0
  for main in $(pgrep -f 'type=zygote' 2>/dev/null | while read -r p; do
        ps -o ppid= -p "$p" 2>/dev/null; done | sort -u); do
    [ -z "$main" ] && continue
    local exe name nrend
    exe=$(readlink -f "/proc/$main/exe" 2>/dev/null) || continue
    [ -z "$exe" ] && continue
    name=$(basename "$exe")
    nrend=$(pgrep -P "$main" -f 'type=renderer' 2>/dev/null | wc -l)
    # los renderers pueden colgar del zygote, no solo del main
    [ "$nrend" -eq 0 ] && nrend=$(ps -eo args= 2>/dev/null | grep -c "^$exe.*--type=renderer")
    if [ "$nrend" -eq 0 ]; then
      echo "  SOSPECHOSO  $name (pid $main): 0 renderers"
      found=$((found + 1))
    fi
  done
  echo "  apps sin renderer:           $found"
  echo

  # --- 6. locks de instancia unica huerfanos -------------------------------
  # Lo que impidio reiniciar el 07-sep: SingletonLock apuntando a un pid muerto.
  echo "-- locks de instancia unica huerfanos --"
  local orph=0 checked=0
  while IFS= read -r lock; do
    checked=$((checked + 1))
    local target pid
    target=$(readlink "$lock" 2>/dev/null) || continue
    pid=${target##*-}
    case "$pid" in
      ''|*[!0-9]*) continue ;;
    esac
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "  HUERFANO  $lock -> $target (pid $pid no existe)"
      orph=$((orph + 1))
    fi
  done < <(find "$HOME/.config" -maxdepth 2 -name 'SingletonLock' -type l 2>/dev/null)
  echo "  locks revisados:             $checked"
  echo "  locks huerfanos:             $orph"
  echo

  # --- 6b. boot anterior: GDM llego a iniciar pero nadie inicio sesion? ----
  # (FEATURE-GDM-BOOT-COLGADO). Distinto del check de Electron de arriba, que
  # exige un proceso --type=zygote ya vivo -- opera DESPUES de que arranca
  # una sesion de usuario. Un cuelgue de GDM (pantalla de login) antes de esa
  # sesion, con los servicios de arranque en "[OK]" y colgado ahi
  # indefinidamente (HARVEST-347951), es una capa distinta que nada cubria.
  # Se revisa el boot ANTERIOR (forense, como el resto de bb scan): si esta
  # colgado AHORA, no hay como correr bb scan para verlo.
  echo "-- boot anterior: gdm llego a iniciar pero nadie inicio sesion? --"
  if have journalctl; then
    local gdm_line
    gdm_line=$(journalctl -b -1 --no-pager -u gdm --no-hostname 2>/dev/null | grep -m1 "Started gdm.service")
    if [ -z "$gdm_line" ]; then
      echo "  (boot anterior no tiene gdm.service -- headless o no disponible)"
    else
      # gdm abre su PROPIA sesion interna (uid gdm) ademas de la del usuario
      # que hace login real -- 1 sola sesion en todo el boot es solo la de
      # gdm, sin login real despues.
      local logins
      logins=$(journalctl -b -1 --no-pager 2>/dev/null | grep -c "New session .* of user" || true)
      if [ "${logins:-0}" -le 1 ]; then
        echo "  AVISO: gdm.service inicio en el boot anterior y no se registro ningun login real despues"
      else
        echo "  boot anterior: gdm inicio y hubo ${logins:-0} sesion(es) -- login normal"
      fi
    fi
  else
    cannot_run "GDM boot anterior" "journalctl no disponible"
  fi
  echo

  # --- 7. presion de memoria segun nuestras propias muestras ---------------
  echo "-- presion de memoria (muestras de blackbox) --"
  local nsamp
  nsamp=$(cat "$SAMPLES"/*.jsonl 2>/dev/null | wc -l)
  echo "  muestras en disco:           $nsamp"
  if [ "$nsamp" -eq 0 ]; then
    cannot_run "serie de memoria" "no hay muestras -- el timer no esta corriendo (bb install)"
    echo "  minimo de MemFree:           COULD_NOT_RUN"
  else
    cat "$SAMPLES"/*.jsonl 2>/dev/null |
      sed -n 's/.*"ts":"\([^"]*\)","mem_free_kb":\([0-9]*\).*/\1 \2/p' |
      sort -k2 -n | head -1 |
      awk '{printf "  MemFree minimo:  %6.1f GB  el %s\n", $2/1048576, $1}'
    cat "$SAMPLES"/*.jsonl 2>/dev/null |
      sed -n 's/.*"zombies":\([0-9]*\).*/\1/p' | sort -n | tail -1 |
      awk '{printf "  pico de zombis:  %s\n", $1}'
    # apps Electron que en algun momento se quedaron sin renderizador
    local norend
    norend=$(grep -ho '{"app":"[^"]*","pid":[0-9]*,"renderers":0}' "$SAMPLES"/*.jsonl 2>/dev/null |
      sed 's/.*"app":"\([^"]*\)".*/\1/' | sort -u | tr '\n' ' ')
    echo "  apps vistas sin renderizador: ${norend:-ninguna}"
  fi
  echo

  # --- 7b. red y CPU por nucleo (muestras de blackbox) ---------------------
  # `bb sample` guarda contadores crudos de red y CPU desde 2026-09-07
  # (red_bytes()/cpu_jiffies() arriba), pero hasta hoy NADA los leia: el dato
  # se acumulaba en disco y `bb scan` nunca cruzaba dos muestras para sacar
  # una tasa. Hallazgo propio al revisar el codigo contra la cosecha de Atlas
  # (HARVEST-351340/362964/366125, FEATURE-RED-CPU-SCAN): no faltaba un
  # mecanismo de captura nuevo, faltaba el analisis sobre el que ya existia.
  echo "-- red y CPU por nucleo (muestras de blackbox) --"
  if [ "$(cat "$SAMPLES"/*.jsonl 2>/dev/null | wc -l)" -lt 2 ]; then
    cannot_run "red/CPU por nucleo" "hacen falta 2 muestras y hay menos"
    echo "  tasas de red/CPU:            COULD_NOT_RUN"
  else
    cat "$SAMPLES"/*.jsonl 2>/dev/null | python3 -c '
import json, sys
from datetime import datetime


def parse_pairs(s, n):
    out = {}
    for tok in (s or "").split(","):
        if not tok:
            continue
        parts = tok.split(":")
        if len(parts) != n:
            continue
        out[parts[0]] = [int(x) for x in parts[1:]]
    return out


# Las muestras mas viejas retenidas (antes de 2026-09-07 tarde) no tienen
# "cpu_jiffies"/"red": el campo se agrego a mitad de dia. Tomar la PRIMERA
# linea del archivo sin mas daba "primero" sin esos campos y una ventana
# vacia por diseno -- lo destapo el control negativo (misma corrida con
# "1 hora" vs "1 segundo" daba identico resultado), no el caso positivo.
# Por eso "primero"/"ultimo" se buscan por separado para cada campo, sobre
# solo las lineas que SI lo traen.
primero_cpu = ultimo_cpu = primero_red = ultimo_red = None
for linea in sys.stdin:
    try:
        d = json.loads(linea)
    except Exception:
        continue
    if d.get("cpu_jiffies"):
        if primero_cpu is None:
            primero_cpu = d
        ultimo_cpu = d
    if d.get("red"):
        if primero_red is None:
            primero_red = d
        ultimo_red = d

if primero_cpu is None or ultimo_cpu is primero_cpu:
    print("  CPU por nucleo: (sin ventana con dato -- faltan >= 2 muestras con cpu_jiffies)")
else:
    t0 = datetime.strptime(primero_cpu["ts"][:19], "%Y-%m-%dT%H:%M:%S")
    t1 = datetime.strptime(ultimo_cpu["ts"][:19], "%Y-%m-%dT%H:%M:%S")
    dt = (t1 - t0).total_seconds()

    # CPU por nucleo: un promedio de maquina esconde un solo nucleo saturado
    # (medido: cpu19 al 72% invisible en el promedio, README "Cherry-pick").
    cpu0 = parse_pairs(primero_cpu.get("cpu_jiffies"), 3)
    cpu1 = parse_pairs(ultimo_cpu.get("cpu_jiffies"), 3)
    picos = []
    for core, (idle1, tot1) in cpu1.items():
        if core not in cpu0:
            continue
        idle0, tot0 = cpu0[core]
        dtot = tot1 - tot0
        didle = idle1 - idle0
        if dtot <= 0:
            continue
        busy = 100.0 * (1 - didle / dtot)
        picos.append((busy, core))
    if picos:
        picos.sort(reverse=True)
        print("  nucleo mas ocupado en la ventana: %s al %.1f%%" % (picos[0][1], picos[0][0]))
        saturados = [c for b, c in picos if b >= 90]
        if saturados:
            print("  AVISO: %d nucleo(s) >= 90%% sostenido: %s" % (len(saturados), ", ".join(saturados)))
    else:
        print("  CPU por nucleo: (sin dato en las muestras)")

# Red: contadores crudos rx/tx por interfaz fisica. Una caida a 0 KB/s
# sostenida, o un contador que retrocede (reconexion), son la senal que
# HARVEST-351340/366125 pedian y que sar guarda en otro fichero/formato.
if primero_red is None or ultimo_red is primero_red:
    print("  red por interfaz: (sin ventana con dato -- faltan >= 2 muestras con \"red\")")
else:
    t0r = datetime.strptime(primero_red["ts"][:19], "%Y-%m-%dT%H:%M:%S")
    t1r = datetime.strptime(ultimo_red["ts"][:19], "%Y-%m-%dT%H:%M:%S")
    dtr = (t1r - t0r).total_seconds()
    red0 = parse_pairs(primero_red.get("red"), 3)
    red1 = parse_pairs(ultimo_red.get("red"), 3)
    if dtr > 0:
        for iface, (rx1, tx1) in red1.items():
            if iface not in red0:
                continue
            rx0, tx0 = red0[iface]
            drx, dtx = rx1 - rx0, tx1 - tx0
            if drx < 0 or dtx < 0:
                print("  %-10s contador retrocedio (interfaz se reconecto?)" % iface)
                continue
            print("  %-10s rx %8.1f KB/s  tx %8.1f KB/s  (%d s)" % (
                iface, drx / dtr / 1024, dtx / dtr / 1024, int(dtr)))
            if drx == 0 and dtx == 0:
                print("    AVISO: cero trafico en toda la ventana pese a tener contador activo")
    else:
        print("  red: ventana de 0 segundos, sin tasa")
' 2>/dev/null || echo "  red/CPU: (python3 no pudo analizar las muestras)"
  fi
  echo

  # --- 8. fuentes que ya existian en la maquina ---------------------------
  echo "-- GPU (gpu_sampler.sh, cada 15s) --"
  # El CSV de la fecha de la VENTANA, no el de hoy: `bb scan "2026-09-07 19:00"`
  # buscaba el fichero de hoy y decia "sin CSV" sobre una ventana que si lo
  # tenia. Lo destapo el control negativo, no el caso positivo.
  local gcsv; gcsv="/srv/ai/logs/gpu/gpu_telemetry_$(date -d "$since" +%F 2>/dev/null || date +%F).csv"
  if [ -f "$gcsv" ]; then
    local since_hm; since_hm=$(date -d "$since" '+%Y-%m-%dT%H:%M:%S')
    local nto nrows
    nto=$(awk -F, -v s="$since_hm" '$1>=s && ($2=="TIMEOUT"||$2=="ERROR")' "$gcsv" 2>/dev/null | wc -l)
    nrows=$(awk -F, -v s="$since_hm" '$1>=s' "$gcsv" 2>/dev/null | wc -l)
    echo "  muestras en la ventana:      $nrows"
    echo "  driver sin responder:        $nto"
    awk -F, -v s="$since_hm" '$1>=s && $2=="OK" && $5!="" {if($5>mx) {mx=$5; mt=$1}} END{if(mx!="") printf "  temperatura maxima:          %s C  (%s)\n", mx, mt}' "$gcsv" 2>/dev/null
    awk -F, -v s="$since_hm" '$1>=s && $2=="OK" && $9!="" && $9!="0x0000000000000000"' "$gcsv" 2>/dev/null | wc -l |
      awk '{printf "  filas con throttle activo:   %s\n", $1}'
  else
    # NO es un COULD_NOT_RUN: gpu_sampler.sh esta suspendido a proposito desde
    # el 2026-09-07 y no escribe CSV nuevos. Su trabajo lo hace la seccion
    # termica de abajo. Solo seria una averia si TAMPOCO hubiera telemetria de
    # Atlas fresca, y eso ya lo vigila esa seccion.
    echo "  (sin CSV para esta ventana: gpu_sampler suspendido el 2026-09-07,"
    echo "   sus campos los cubre atom_gpu_telemetry.py -- los CSV anteriores"
    echo "   a esa fecha siguen en /srv/ai/logs/gpu/ y si se leen)"
  fi
  echo

  echo "-- termica (Atlas/atom_gpu_telemetry.py, cada 5s) --"
  local ajl="$ATLAS_TELEMETRY"
  if [ -f "$ajl" ]; then
    local since_iso; since_iso=$(date -u -d "$since" '+%Y-%m-%dT%H:%M:%S' 2>/dev/null)
    # Solo cuentan los eventos que el propio instrumento CORROBORA: escribe
    # tambien los picos aislados de sensor, y son la gran mayoria (1093 de
    # 1223 al 2026-09-07). Contar los descartados daria una alarma falsa.
    local tc td mp
    tc=$(grep -a '"evento": *"temp_critica"' "$ajl" 2>/dev/null |
      grep '"corroboracion": *"corrobora"' | awk -v s="$since_iso" -F'"' '$4>=s' | wc -l)
    td=$(grep -a '"evento": *"temp_critica"' "$ajl" 2>/dev/null |
      grep '"corroboracion": *"descarta"' | awk -v s="$since_iso" -F'"' '$4>=s' | wc -l)
    mp=$(grep -a '"evento": *"mitigacion_pausa"' "$ajl" 2>/dev/null |
      awk -v s="$since_iso" -F'"' '$4>=s' | wc -l)
    echo "  eventos termicos REALES:     $tc"
    echo "  picos de sensor descartados: $td  (ruido, no eventos)"
    echo "  pausas por mitigacion:       $mp"
    [ "${tc:-0}" -gt 0 ] && grep -a '"corroboracion": *"corrobora"' "$ajl" |
      awk -v s="$since_iso" -F'"' '$4>=s' | tail -3 | sed 's/^/    /' | cut -c1-160
  else
    cannot_run "termica de Atlas" "no existe $ajl -- atom-gpu-telemetry parado?"
    echo "  eventos termicos:            COULD_NOT_RUN"
  fi
  echo

  # --- 8b. reloj/pstate vs. bandera de throttle (FEATURE-CLOCK-THROTTLE- ---
  # CRUZADO). atom_gpu_telemetry.py ya escribe sm_clk_mhz/pstate/throttle en
  # cada muestra desde el 2026-09-07 (absorbidos de gpu_sampler.sh), pero
  # hasta hoy esta seccion solo leia temp_critica/mitigacion_pausa del mismo
  # JSONL -- nunca esos tres campos. Un reloj bajo SOSTENIDO con utilizacion
  # alta y SIN bandera de throttle es la firma que HARVEST-364166/374274/
  # 376039 reportan y que hoy es invisible aunque el dato ya se escriba.
  # Umbral PROVISIONAL (800 MHz con >50% de utilizacion): igual que los
  # umbrales de PSI, sale del rango de clock ya registrado (300-2800 MHz),
  # no de un incidente propio calibrado en esta maquina.
  if [ -f "$ajl" ]; then
    grep -a '"evento": *"muestra"' "$ajl" 2>/dev/null |
      awk -v s="$since_iso" -F'"' '$4>=s' | python3 -c '
import json, sys

atascados = []
n = 0
for linea in sys.stdin:
    try:
        d = json.loads(linea)
    except Exception:
        continue
    clk = d.get("sm_clk_mhz")
    util = d.get("gpu_util_pct")
    thr = d.get("throttle")
    if clk is None or util is None or thr is None:
        continue
    n += 1
    if clk < 800 and util > 50 and thr == "0x0000000000000000":
        atascados.append((d.get("ts", "")[:19], clk, util))
print("  muestras con clock/pstate/throttle: %d" % n)
if atascados:
    print("  AVISO: %d muestra(s) con reloj < 800MHz, util > 50%%, SIN throttle:" % len(atascados))
    for ts, clk, util in atascados[-3:]:
        print("    %s  clock=%.0fMHz  util=%.0f%%" % (ts, clk, util))
else:
    print("  reloj atascado sin throttle:  0")
' 2>/dev/null || echo "  reloj/throttle: (python3 no pudo analizar las muestras)"
  fi
  echo

  # --- 8c. GPU con memoria reservada y 0% de utilizacion sostenido ---------
  # (FEATURE-GPU-UTIL-CERO-FALLBACK-CPU). Mismo patron que el tok/s de
  # trafico real ya adoptado: un proceso con memoria de GPU reservada
  # (gpu_procs, 1 de cada 3 muestras) que luego pasa varias muestras seguidas
  # con gpu_util_pct=0 esta corriendo en fallback silencioso a CPU -- el
  # driver no fallo, nadie lo reporta, y hoy nada lo correlaciona.
  if [ -f "$ajl" ]; then
    grep -a '"evento": *"muestra"' "$ajl" 2>/dev/null |
      awk -v s="$since_iso" -F'"' '$4>=s' | python3 -c '
import json, sys

ultimos_procs = None
racha = 0
avisos = []
for linea in sys.stdin:
    try:
        d = json.loads(linea)
    except Exception:
        continue
    procs = d.get("gpu_procs")
    if procs:
        ultimos_procs = procs
    util = d.get("gpu_util_pct")
    if util is None:
        continue
    if util == 0 and ultimos_procs:
        racha += 1
        if racha == 3:
            nombres = ", ".join("%s (%.0fMiB)" % (p.get("nombre", "?"), p.get("mem_mib", 0)) for p in ultimos_procs)
            avisos.append((d.get("ts", "")[:19], nombres))
    else:
        racha = 0
if avisos:
    print("  AVISO: %d caso(s) de 0%% de utilizacion sostenida con memoria de GPU reservada:" % len(avisos))
    for ts, nombres in avisos[-3:]:
        print("    %s  proceso(s): %s" % (ts, nombres))
else:
    print("  GPU con memoria reservada y 0% util sostenido: 0")
' 2>/dev/null || echo "  fallback a CPU: (python3 no pudo analizar las muestras)"
  fi
  echo

  echo "-- margen de memoria (monitor_memory.sh, cada 5 min) --"
  if [ -f /srv/ai/logs/memory_monitor.log ]; then
    local nwarn
    # -a: el log tiene bytes binarios y sin esto grep se niega a leerlo entero
    nwarn=$(grep -ac 'WARNING' /srv/ai/logs/memory_monitor.log 2>/dev/null || echo 0)
    echo "  avisos historicos de margen: $nwarn"
    echo "  ultimo aviso:                $(grep -a 'WARNING' /srv/ai/logs/memory_monitor.log 2>/dev/null | tail -1 | cut -c1-19)"
    [ "${nwarn:-0}" -gt 0 ] && grep -a 'WARNING' /srv/ai/logs/memory_monitor.log | tail -3 | sed 's/^/    /'
  else
    cannot_run "monitor de memoria" "no existe /srv/ai/logs/memory_monitor.log"
    echo "  avisos de margen:            COULD_NOT_RUN"
  fi
  echo

  # --- 8b. motor de inferencia y contenedores -----------------------------
  # El 2026-09-08 el gateway se cayo y nadie lo reporto. Se mira el ENDPOINT,
  # no el contenedor: durante la carga del modelo el contenedor esta "Up" y el
  # endpoint todavia no responde.
  echo "-- motor de inferencia --"
  local gw_ahora; gw_ahora=$(gateway_modelo)
  echo "  ahora mismo:                 ${gw_ahora:-CAIDO (no responde $GATEWAY_URL)}"
  local caidas
  caidas=$(grep -ho '"gateway":"[^"]*"' "$SAMPLES"/*.jsonl 2>/dev/null | grep -c 'CAIDO' || true)
  local conmuestra
  conmuestra=$(grep -ho '"gateway":"[^"]*"' "$SAMPLES"/*.jsonl 2>/dev/null | wc -l)
  echo "  muestras con el gateway caido: ${caidas:-0} de ${conmuestra:-0}"
  echo "  contenedores (vivos/total):  $(docker_estado 2>/dev/null || echo '?')"
  # Fallback silencioso a modo "legacy" (sin GPU real) por fallo del
  # prestart hook OCI de nvidia-container-runtime (FEATURE-NVIDIA-CONTAINER-
  # RUNTIME-HOOK, HARVEST-351579): el contenedor puede reportar "Up" con el
  # hook fallando por debajo -- mismo espiritu que el resto de esta seccion
  # (mirar el ENDPOINT/hook, no solo el estado del contenedor).
  local nhook
  nhook=$(journalctl -S "$since_fmt" --no-pager 2>/dev/null |
    grep -icE 'nvidia-container-(runtime|cli).*(error|fail)|OCI runtime.*nvidia.*fail|failed to initialize NVML' || true)
  echo "  fallos de prestart hook OCI/nvidia: ${nhook:-0}"
  [ "${nhook:-0}" -gt 0 ] && journalctl -S "$since_fmt" --no-pager 2>/dev/null |
    grep -iE 'nvidia-container-(runtime|cli).*(error|fail)|OCI runtime.*nvidia.*fail|failed to initialize NVML' |
    tail -3 | sed 's/^/    /'
  # tok/s del trafico REAL, derivado de los contadores entre muestras. Un
  # gateway degradado responde igual de "vivo": esto es lo que lo delata.
  cat "$SAMPLES"/*.jsonl 2>/dev/null | python3 -c '
import json, sys
from datetime import datetime
prev = None
picos, errores, preempt = [], 0, 0
for linea in sys.stdin:
    try: d = json.loads(linea)
    except Exception: continue
    s = d.get("gw_salud") or ""
    partes = s.split(",")
    if len(partes) < 7: continue
    try:
        gen, err, pre = int(partes[4]), int(partes[6]), int(partes[3])
        ts = datetime.strptime(d["ts"][:19], "%Y-%m-%dT%H:%M:%S")
    except Exception: continue
    if prev:
        dt = (ts - prev[0]).total_seconds()
        dgen = gen - prev[1]
        if dt > 0 and dgen > 0: picos.append((dgen / dt, d["ts"][11:19]))
    errores, preempt = max(errores, err), max(preempt, pre)
    prev = (ts, gen)
if picos:
    mx = max(picos); print("  pico de generacion:          %.1f tok/s (%s)" % mx)
    print("  intervalos con trafico:      %d" % len(picos))
else:
    print("  pico de generacion:          sin trafico en las muestras")
print("  peticiones con error:        %d" % errores)
print("  preempciones (presion KV):   %d" % preempt)
' 2>/dev/null || echo "  rendimiento: (no se pudo derivar)"
  echo

  # --- 9a. presion real del kernel (PSI) ----------------------------------
  # Ni MemFree ni MemAvailable dicen cuanto se esta SUFRIENDO por memoria; PSI
  # si, porque mide tiempo de tareas paradas. El MECANISMO (leer /proc/pressure)
  # sigue viniendo de sparkview (foro NVIDIA 366877, ingerido en Atlas).
  #
  # Los CORTES ya no. Corte calibrado 2026-09-23 contra los dos congelamientos
  # propios del 2026-09-22/23 -- ambos terminados en reset duro -- sobre 19799
  # muestras (2026-09-08 07:57 -> 2026-09-23 10:48). Cierra
  # DEBT-PSI-UMBRALES-SIN-CALIBRAR.
  #
  # Que mostro la calibracion, y por que cambio la forma del corte y no solo
  # sus numeros:
  #
  #   La escala vieja (LOW <5, MODERATE <20, HIGH <50, CRITICAL) clasificaba
  #   por NIVEL instantaneo, y en esta maquina el nivel se equivoca en las DOS
  #   direcciones: seis excursiones llegaron hasta 98.53 % sin colgar nada, y
  #   el valor mas bajo que sostuvo un congelamiento real fue 48.80 %. Sus
  #   bandas intermedias ademas no se ocupan: 97.84 % de las muestras tienen
  #   mem_full EXACTAMENTE 0.00 y solo 26 de 19799 caen entre 5 y 50, asi que
  #   MODERATE y HIGH etiquetaban un tramo por el que esta maquina no pasa.
  #
  #   La TASA de subida tampoco discrimina, aunque lo parezca: las dos mayores
  #   subidas de todo el corpus en <=90 s (+76.30 y +68.96 puntos) son de dias
  #   sanos, y el arranque del congelamiento del 05:45 fue solo la tercera
  #   (+65.60). Un corte por tasa dispara dos veces en falso antes de acertar.
  #
  #   Lo que discrimina es la DURACION. Las seis excursiones sanas duraron <=2
  #   min sobre el 10 % y se recuperaron solas; los dos congelamientos duraron
  #   1042 y 292 min. Dos ordenes de magnitud de separacion.
  #
  # Que la etiqueta "sana" no es circular: la confirma sar, que no es PSI. En
  # las seis excursiones sanas ldavg-1 volvio por debajo de 5 en menos de 6 min
  # y plist-sz se desplomo (el proceso que comia memoria salio solo). En los dos
  # congelamientos ldavg-1 se quedo entre 100 y 185 durante la ventana entera
  # -- con 32-47 GB LIBRES segun kbavail todo el rato, que es exactamente por
  # que ninguna metrica de NIVEL de memoria los vio venir.
  #
  # Limites declarados, porque esto es un instrumento y no un oraculo:
  #   1. n=2 del lado positivo, y las dos la misma noche: probablemente la misma
  #      causa raiz. La banda COLAPSO esta calibrada, no validada.
  #   2. Entre 3 y 5 min no hay NI UNA excursion en 15 dias. Esa banda se
  #      imprime como SIN OBSERVAR en vez de asignarse a un lado.
  #   3. Las duraciones son COTA INFERIOR: durante un congelamiento el propio
  #      muestreador se queda sin CPU (sus intervalos pasaron de 1 min a 17-66
  #      min), asi que los bordes caen donde alcanzo a correr.
  #   4. Esto REPORTA, no avisa a tiempo: la confirmacion del segundo
  #      congelamiento llego 57 min despues de empezar, por el mismo motivo.
  #      El guardarrail en vivo es bin/bb-usable, que no usa esta escala --
  #      decide por una sonda de asignacion.
  #   5. Solo el canal de MEMORIA esta calibrado. io_some y cpu_some tienen
  #      otra distribucion entera (cpu_some pasa de 5 % en 1473 muestras, mem
  #      solo en 132): aplicarles la misma escala fue el error original, y
  #      seguir sin incidente propio que los etiquete es motivo para NO
  #      ponerles etiqueta, no para heredarla.
  #
  # Re-derivable, no congelado en este comentario: `python3 tools/calibra_psi.py`
  # recalcula los cortes desde el corpus y sale 1 si dejan pasar un incidente o
  # si disparan en una muestra sana.
  echo "-- presion del kernel (PSI, corte calibrado 2026-09-23) --"
  if [ -r /proc/pressure/memory ]; then
    cat "$SAMPLES"/*.jsonl 2>/dev/null | python3 -c '
import json, sys, datetime as dt
UMBRAL, SOSTENIDO, PICO_MAX = 10.0, 5.0, 3.0
picos = {"mem_some": (0, ""), "mem_full": (0, ""), "io_some": (0, ""), "cpu_some": (0, "")}
n = cero = 0
serie = []
for linea in sys.stdin:
    try: d = json.loads(linea)
    except Exception: continue
    p = d.get("psi")
    if not p: continue
    n += 1
    for k in picos:
        v = p.get(k, 0)
        if isinstance(v, (int, float)) and v > picos[k][0]:
            picos[k] = (v, d.get("ts", "")[:19].replace("T", " "))
    f = p.get("mem_full", 0)
    if not isinstance(f, (int, float)): f = 0
    if f == 0: cero += 1
    try: t = dt.datetime.strptime(d.get("ts", ""), "%Y-%m-%dT%H:%M:%S%z")
    except Exception: continue
    serie.append((t, f))

serie.sort(key=lambda r: r[0])
excs, actual = [], []
for m in serie:
    if m[1] >= UMBRAL: actual.append(m)
    elif actual: excs.append(actual); actual = []
if actual: excs.append(actual)

def dur(e): return (e[-1][0] - e[0][0]).total_seconds() / 60.0
colapsos = [e for e in excs if dur(e) >= SOSTENIDO]
sanas    = [e for e in excs if dur(e) <= PICO_MAX]
grises   = [e for e in excs if PICO_MAX < dur(e) < SOSTENIDO]

if n == 0:
    print("  muestras con PSI:            0 (aun no hay)")
else:
    print("  muestras con PSI:            %d" % n)
    print("  linea base (mem_full 0.00):  %d  (%.2f %%)" % (cero, 100.0 * cero / n))
    print("  -- memoria: canal CALIBRADO contra los 2 congelamientos propios --")
    for k, etiq in (("mem_full", "memoria (TODAS paradas)"),
                    ("mem_some", "memoria (alguna parada)")):
        v, ts = picos[k]
        print("  pico %-24s %6.2f %%   %s" % (etiq, v, ts))
    print("  excursiones con mem_full >= %g %%:" % UMBRAL)
    for etiq, cuantas, nota in (
            ("PICO         (<= %g min)" % PICO_MAX, len(sanas), "se recuperan solas, no predicen colapso"),
            ("SIN OBSERVAR (%g-%g min)" % (PICO_MAX, SOSTENIDO), len(grises), "banda vacia en la calibracion"),
            ("COLAPSO      (>= %g min)" % SOSTENIDO, len(colapsos), "")):
        print("    %-24s %4d   %s" % (etiq, cuantas, nota))
    for e in colapsos:
        print("      %s  %5.0f min  pico %.2f %%" % (e[0][0].strftime("%Y-%m-%d %H:%M"), dur(e), max(v for _, v in e)))
    if colapsos:
        print("    AVISO: los 2 COLAPSO de referencia solo salieron con reset duro.")
    print("  -- E/S y CPU: canales SIN CALIBRAR (ningun incidente propio los etiqueta) --")
    for k, etiq in (("io_some", "E/S"), ("cpu_some", "CPU")):
        v, ts = picos[k]
        print("  pico %-24s %6.2f %%   %s" % (etiq, v, ts))
    print("    (pico sin etiqueta a proposito: heredar la escala ajena fue el fallo original)")
' 2>/dev/null || echo "  PSI: (python3 no pudo analizar las muestras)"
  else
    cannot_run "PSI" "/proc/pressure/memory no legible (kernel sin CONFIG_PSI?)"
    echo "  PSI:                         COULD_NOT_RUN"
  fi
  echo

  # --- 9b. procesos con el directorio de trabajo borrado ------------------
  # Un servicio cuyo cwd se borro sigue "activo" y responde, pero todo lo que
  # lance muere en getcwd(). Medido 2026-09-08: `ollama serve` heredo su cwd de
  # un worktree de agente que luego se limpio, y durante 8h42m cada
  # llama-server aborto con una excepcion C++ no capturada -- 14158 volcados,
  # 2.2 GB. Nada lo reportaba: el proceso estaba vivo y el puerto respondia.
  echo "-- procesos con el cwd borrado --"
  local cwdmuertos=0 revisados=0
  for p in $(ps -eo pid=,etimes= 2>/dev/null | awk '$2 > 300 {print $1}'); do
    local c; c=$(readlink "/proc/$p/cwd" 2>/dev/null) || continue
    revisados=$((revisados + 1))
    case "$c" in
      *" (deleted)")
        echo "  MUERTO  pid=$p $(ps -o comm= -p "$p" 2>/dev/null): ${c%\ (deleted)}"
        cwdmuertos=$((cwdmuertos + 1)) ;;
    esac
  done
  echo "  procesos revisados (>5 min): $revisados"
  echo "  con el cwd borrado:          $cwdmuertos"
  [ "$cwdmuertos" -gt 0 ] && echo "    Se arregla relanzandolos desde un directorio que exista."
  echo

  # --- 10. DGX-438: procesos python que desaparecen -----------------------
  # Atlas midio muertes con rc=143 (SIGTERM) cada 10-15 min sin causa raiz.
  # Un SIGTERM ajeno no deja linea en el journal ni core dump, asi que la via
  # es comparar muestras consecutivas: un pid que estaba y ya no esta, sin OOM
  # ni evento termico en medio, es un candidato.
  echo "-- procesos python desaparecidos (DGX-438) --"
  if [ "$(cat "$SAMPLES"/*.jsonl 2>/dev/null | wc -l)" -lt 2 ]; then
    cannot_run "desapariciones python" "hacen falta 2 muestras y hay menos"
    echo "  desapariciones:              COULD_NOT_RUN"
  else
    cat "$SAMPLES"/*.jsonl 2>/dev/null | python3 -c '
import json, sys
prev, prev_ts, hallazgos = None, None, []
for linea in sys.stdin:
    try: d = json.loads(linea)
    except Exception: continue
    cur = set(d.get("py_bg") or [])
    if prev is not None:
        idos = prev - cur
        if idos:
            hallazgos.append((prev_ts, d.get("ts"), sorted(idos)))
    prev, prev_ts = cur, d.get("ts")
print("  transiciones con desaparicion: %d" % len(hallazgos))
for a, b, pids in hallazgos[-5:]:
    print("    entre %s y %s: pid(s) %s" % (a[11:19], b[11:19], ", ".join(map(str, pids))))
if not hallazgos:
    print("    (ninguna en las muestras guardadas)")
' 2>/dev/null || echo "  desapariciones:              (python3 no pudo analizar)"
    echo "  Nota: una desaparicion NO prueba SIGTERM ajeno -- un proceso que"
    echo "  termina bien tambien desaparece. Cruzar con OOM y termica de arriba."
  fi
  echo

  # --- clasificador de causa de apagado/reinicio no limpio -----------------
  # (FEATURE-SHUTDOWN-CAUSA-CLASIFICADOR). Arma UN veredicto cruzando PCIe
  # (nuevo aqui) con OOM/termico (ya calculados arriba en esta misma corrida)
  # -- hoy hay que leer tres secciones y cruzar a mano, el mismo costo que ya
  # motivo consolidar "Red y CPU por nucleo". No reemplaza los conteos de
  # arriba, los resume en una linea.
  echo "-- clasificador de causa de apagado/reinicio no limpio --"
  local npower nnaer
  npower=$(journalctl -k -S "$since_fmt" --no-pager 2>/dev/null |
    grep -icE 'mlx5_pcie_event.*insufficient power' || true)
  # OJO: un grep amplio de "AER:|hotplug" cuenta tambien el RUIDO de
  # inicializacion al boot ("AER: enabled with IRQ", "pciehp: Slot #N
  # AttnBtn-...") -- medido: 28 lineas con ese patron amplio, de las cuales
  # solo 5 eran errores reales. El patron de abajo exige la palabra "error"
  # o la firma real de RxErr/remocion de cable/caida de enlace.
  nnaer=$(journalctl -k -S "$since_fmt" --no-pager 2>/dev/null |
    grep -icE 'AER: (Corrected|Uncorrected|Correctable|Fatal) error|\] RxErr|Cable removal|Link Down' || true)
  echo "  PCIe: insuficiencia de energia:  ${npower:-0}"
  echo "  PCIe: errores AER/RxErr/cable:   ${nnaer:-0}"
  # Replay counter de NVML (seccion PCI de `nvidia-smi -q`, sin -d: esta
  # seccion no tiene su propia categoria en este driver). Un reintento de
  # capa de enlace puede pasar SIN que el kernel escriba una linea AER --
  # depende de mascaras de severidad -- asi que es una fuente distinta de la
  # de arriba, no un duplicado. Verificado 2026-09-11 en este GB10: existe
  # como "Replays Since Reset"/"Replay Number Rollovers", ambos en 0 ahora.
  #
  # OJO -- lo que NO se agrega aqui y por que: `pcie.link.width.current` en
  # este chip esta en 1x contra un maximo de 16x, pero se comprobo con carga
  # real (burst CUDA, 96% de utilizacion) que NO retrena -- se queda en 1x
  # igual con GPU ociosa que a plena carga. Confirmado 2026-09-12, ya no es
  # solo hipotesis propia: la guia oficial de dgx-spark-fieldiag (NVIDIA)
  # tiene un test aparte llamado "C2CStress" ("stress chip-to-chip interface
  # between CPU and GPU"), distinto de GpuStress/CpuStress -- prueba
  # independiente de que NVLink-C2C es la via real en GB10 y esta PCI
  # enumerada no. Comparar current contra max aqui seria un falso positivo
  # PERMANENTE, no ocasional -- el mismo error que el patron amplio de AER
  # ya corrigio arriba, asi que no se repite con otro campo.
  local pciraw nreplay_reset nreplay_roll
  if have nvidia-smi; then
    pciraw=$(timeout 5 nvidia-smi -q 2>/dev/null)
    nreplay_reset=$(awk -F': *' '/Replays Since Reset/{print $2; exit}' <<<"$pciraw")
    nreplay_roll=$(awk -F': *' '/Replay Number Rollovers/{print $2; exit}' <<<"$pciraw")
  fi
  echo "  PCIe: replays NVML desde el ultimo reset: ${nreplay_reset:-N/A}"
  echo "  PCIe: rollovers del contador de replay:   ${nreplay_roll:-N/A}"
  local indicadores=""
  { [ "${nreplay_reset:-0}" -gt 0 ] 2>/dev/null || [ "${nreplay_roll:-0}" -gt 0 ] 2>/dev/null; } &&
    indicadores="${indicadores}replays PCIe (NVML), "
  [ "${npower:-0}" -gt 0 ] && indicadores="${indicadores}energia PCIe insuficiente, "
  [ "${nnaer:-0}" -gt 0 ] && indicadores="${indicadores}errores PCIe (AER/RxErr/cable), "
  [ "${koom:-0}" -gt 0 ] && indicadores="${indicadores}OOM del kernel, "
  [ "${nvoom:-0}" -gt 0 ] && indicadores="${indicadores}OOM del driver NVIDIA, "
  [ "${tc:-0}" -gt 0 ] && indicadores="${indicadores}evento termico corroborado, "
  if [ -n "$indicadores" ]; then
    echo "  POSIBLE CAUSA en esta ventana: ${indicadores%, }"
  else
    echo "  sin indicador de causa en esta ventana (no prueba que no la haya -- solo"
    echo "  que ninguna de las señales que este scan cruza aparecio)"
  fi
  # Correlacion (NO causalidad) con init/replug de USB o Bluetooth cerca del
  # fin del boot ANTERIOR -- HARVEST-358034 mecanismo 3. Solo señala
  # coincidencia, igual que la nota de "un evento escrito no es un evento
  # ocurrido" de mas arriba en este mismo archivo.
  local prevend
  prevend=$(journalctl -b -1 --no-pager 2>/dev/null | tail -1 | awk '{print $1, $2, $3}')
  if [ -n "$prevend" ]; then
    local nusb
    nusb=$(journalctl -b -1 --no-pager 2>/dev/null | tail -30 | grep -icE 'usb|bluetooth|btusb' || true)
    if [ "${nusb:-0}" -gt 0 ]; then
      echo "  COINCIDENCIA (no causalidad): $nusb evento(s) de USB/Bluetooth en las ultimas lineas del boot anterior, antes de su fin"
    fi
  fi
  echo

  # --- veredicto -----------------------------------------------------------
  echo "-- veredicto --"
  echo "  comprobaciones que NO pudieron correr: $CNR"
  if [ "$CNR" -gt 0 ]; then
    printf '%s' "$CNR_LIST"
    echo
    echo "  Este informe NO esta limpio: $CNR comprobaciones no llegaron a ejecutarse."
  else
    echo "  Todas las comprobaciones corrieron."
  fi
}

# ------------------------------------------------------------------ hardware

cmd_hw() {
  echo "== inventario de hardware =="
  echo "modelo:  $(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || echo '?')"
  echo "kernel:  $(uname -r)"
  echo "so:      $(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME")"
  echo
  echo "-- CPU --"; lscpu 2>/dev/null | grep -E 'Arquitectura|Architecture|Model name|Nombre del modelo|^CPU\(s\)|Thread|N.cleo' | sed 's/^/  /'
  echo
  echo "-- memoria --"
  awk '/MemTotal|MemFree|MemAvailable|SwapTotal/{printf "  %-14s %8.1f GB\n", $1, $2/1048576}' /proc/meminfo
  echo "  nodos NUMA:  $(ls -d /sys/devices/system/node/node[0-9]* 2>/dev/null | wc -l)"
  echo
  echo "-- GPU --"
  if have nvidia-smi; then
    nvidia-smi --query-gpu=name,driver_version,temperature.gpu,utilization.gpu,power.draw \
      --format=csv 2>&1 | sed 's/^/  /'
    echo "  memoria por proceso (unica via fiable en GB10):"
    gpu_procs | sed 's/^/    /' || echo "    (sin procesos de computo)"
    local tot; tot=$(gpu_mem_mib)
    echo "    TOTAL: ${tot:-0} MiB de la RAM unificada"
    echo "  contadores de throttle (acumulado desde el ultimo reinicio del driver):"
    local perf contadores; perf=$(gpu_perf_raw)
    if [ -n "$perf" ]; then
      contadores=$(gpu_throttle_contadores <<<"$perf")
      [ -n "$contadores" ] && printf '%s\n' "$contadores" ||
        echo "    ninguno con tiempo acumulado > 0"
    else
      echo "    (no se pudo leer -q -d PERFORMANCE)"
    fi
  else
    echo "  nvidia-smi no disponible"
  fi
  echo
  echo "-- discos --"; lsblk -d -o NAME,SIZE,MODEL,ROTA 2>/dev/null | grep -v '^loop' | sed 's/^/  /'
  echo
  echo "-- temperaturas --"; have sensors && sensors 2>/dev/null | grep -iE '°C' | head -10 | sed 's/^/  /' || echo "  (sensors sin lecturas)"
  echo
  echo "-- USB (velocidad negociada por dispositivo, sin veredicto) --"
  have lsusb && lsusb -t 2>/dev/null | sed 's/^/  /' || echo "  lsusb no disponible"
  echo
  # Inventario, no arma nada: dgx-spark-fieldiag es la suite OFICIAL de
  # NVIDIA para pre-chequeo de RMA (GpuStress, C2CStress, CpuStress,
  # PowerStress, ThermalStress, FioSSD, MemStress, CX7Stress -- 30-40 min,
  # DISRUPTIVA, mata GUI y docker). blackbox solo dice si esta disponible
  # para cuando haga falta escalar; nunca la ejecuta. `bb scan` lee sus
  # resultados si el operador la corrio (ver -- NVIDIA Field Diagnostic --).
  echo "-- NVIDIA Field Diagnostic (dgx-spark-fieldiag) --"
  if have dpkg-query && dpkg-query -W -f='${Status}' dgx-spark-fieldiag 2>/dev/null | grep -q '^install ok'; then
    local fdver; fdver=$(dpkg-query -W -f='${Version}' dgx-spark-fieldiag 2>/dev/null)
    echo "  instalado: si (version $fdver)"
    echo "  correrla (RMA/calificacion, DISRUPTIVA -- mata GUI y docker, 30-40 min):"
    echo "    sudo init 3 && cd /opt/nvidia/dgx-spark-fieldiag && sudo ./partnerdiag --field"
  else
    echo "  instalado: no -- sudo apt-get install dgx-spark-fieldiag (pre-chequeo de RMA)"
  fi
}

# -------------------------------------------------------------------- status

cmd_status() {
  echo "== estado de la instrumentacion =="
  local armed=0 missing=0 ciego=0 ok

  chk() { # nombre, condicion_ya_evaluada(0=ok), detalle
    if [ "$2" -eq 0 ]; then echo "  ARMADO    $1"; armed=$((armed + 1))
    else echo "  FALTA     $1 -- $3"; missing=$((missing + 1)); fi
  }

  # Tercer veredicto, anadido 2026-09-23. ARMADO/FALTA no alcanzaban: los dos
  # congelamientos del 22 y 23 los vivieron DOS instrumentos armados que no
  # podian disparar, y `bb status` habria dicho ARMADO de los dos. Un
  # instrumento con cero capturas tras varias oportunidades es un defecto del
  # instrumento, nunca evidencia de que el sujeto este limpio -- asi que se
  # dice. CIEGO no se suma a `armado`: se cuenta aparte y se imprime aunque
  # sea cero, para que no se lea como un informe limpio.
  ciego() { # nombre, por_que_no_puede_disparar
    echo "  CIEGO     $1"
    echo "            $2"
    ciego=$((ciego + 1))
  }

  # Cada chequeo captura su $? en "$ok" EN LA MISMA LINEA que la condicion,
  # nunca como argumento bare ($?) en la linea de chk: un $? bare depende de
  # que nada se ejecute entre la condicion y la llamada, y una insercion tan
  # inocente como un echo de depuracion lo pisa en silencio -- el chequeo
  # seguiria corriendo, sin error, mintiendo sobre CUALQUIER instrumento.
  # Detectado por shellcheck (SC2319) 2026-09-11, hallazgo real: los 9
  # chequeos de abajo tenian exactamente este patron.
  systemctl --user is-active blackbox-sample.timer >/dev/null 2>&1; ok=$?
  chk "blackbox: muestreo de apps/zombis" "$ok" "corre: bb install"

  [ -d /var/log/journal ]; ok=$?
  chk "journald persistente" "$ok" "los logs se pierden al reiniciar"

  journalctl -k -n1 >/dev/null 2>&1; ok=$?
  chk "journal del kernel legible" "$ok" "hace falta grupo adm o systemd-journal"

  have coredumpctl; ok=$?
  chk "systemd-coredump" "$ok" "corre: sudo ./enable-privileged.sh"

  [ "$(ulimit -c)" != "0" ]; ok=$?
  chk "limite de core > 0" "$ok" "ulimit -c = 0, no se guardan volcados"

  # sysstat se comprueba por SUS DATOS, no por la variable ENABLED de
  # /etc/default/sysstat: aqui ENABLED="false" y sin embargo el override
  # sysstat-collect.timer.d dispara la recoleccion cada minuto. Leer la
  # variable daba un falso negativo (comprobado 2026-09-07).
  [ -n "$(find /var/log/sysstat -name "sa$(date +%Y%m%d)" -mmin -10 2>/dev/null)" ]; ok=$?
  chk "sar recolectando (datos de hace <10 min)" "$ok" "sin historico de CPU/mem/IO"

  # gpu_sampler.sh NO se comprueba: esta suspendido a proposito desde el
  # 2026-09-07 y su trabajo lo hace atom_gpu_telemetry.py (ver
  # suspended/MANIFIESTO.md). Mantener la comprobacion pedia rearmar justo lo
  # que se acababa de consolidar -- un FALTA que mentia.

  [ -n "$(find /srv/ai/logs -name 'memory_monitor.log' -mmin -10 2>/dev/null)" ]; ok=$?
  chk "monitor de memoria (<10 min)" "$ok" "systemctl --user start ai-memory-monitor.timer"

  # Por sus datos, no por la unit: una unit "active" cuyo proceso dejo de
  # escribir es exactamente el fallo silencioso que buscamos.
  [ -n "$(find "$(dirname "$ATLAS_TELEMETRY")" -name "$(basename "$ATLAS_TELEMETRY")" -mmin -2 2>/dev/null)" ]; ok=$?
  chk "termica de Atlas (atom_gpu_telemetry, <2 min)" "$ok" "systemctl --user start atom-gpu-telemetry"

  systemctl is-active atom-clock-lock.service >/dev/null 2>&1; ok=$?
  chk "clock lock de GPU (300-2800 MHz)" "$ok" "limite termico DGX-342/344/345 sin aplicar"

  systemctl is-active earlyoom.service >/dev/null 2>&1; ok=$?
  chk "earlyoom" "$ok" "sin guardia de OOM en espacio de usuario"

  # earlyoom solo sabe leer MemAvailable y SwapFree. Los dias 22 y 23,
  # MemAvailable marco 56 % durante las 17 horas de congelamiento mientras
  # PSI memory full estaba en 98-99 %: disparo UNA vez (05:51:40) y nunca
  # mas. Sigue siendo util contra un OOM clasico; contra el caso medido, no.
  if systemctl is-active earlyoom.service >/dev/null 2>&1; then
    ciego "earlyoom ante agotamiento de memoria unificada" \
      "su umbral lee MemAvailable, que marco 56% durante los congelamientos del 2026-09-22/23"
  fi

  # RuntimeWatchdogSec vigila a PID 1. Los dos congelamientos lo tuvieron
  # armado (60s) y no disparo ninguna vez: PID 1 estaba sano, escribiendo
  # entre 570 y 1578 lineas de journal por hora. Quien cubre esto es
  # bb-usable, que mide si la maquina SIRVE.
  wdsec=$(systemctl show -p RuntimeWatchdogUSec --value 2>/dev/null)
  case "$wdsec" in ""|0|"0"|infinity) : ;; *)
    systemctl is-active bb-usable.service >/dev/null 2>&1 || \
      ciego "watchdog de hardware ($wdsec) ante una maquina inservible" \
        "vigila a PID 1, que estuvo sano las 17h45m y las 5h55m; arma bb-usable: sudo ./enable-privileged.sh"
  ;; esac

  systemctl is-active bb-usable.service >/dev/null 2>&1; ok=$?
  chk "bb-usable (vigilante de usabilidad, reinicia si la maquina no sirve)" "$ok" \
    "corre: sudo ./enable-privileged.sh"

  [ -n "$(gateway_modelo)" ]; ok=$?
  chk "motor de inferencia sirviendo" "$ok" "el gateway no responde en $GATEWAY_URL"

  have nvidia-smi; ok=$?
  chk "nvidia-smi" "$ok" "sin telemetria de GPU"

  # enable-privileged.sh solo arma coredump de USERSPACE. Un apagado duro por
  # corte de VRM/PMIC no deja rastro de kernel -- FEATURE-KDUMP-PSTORE-
  # PREAPAGADO. Hallazgo real (2026-09-09): kdump-tools YA esta instalado y
  # armado en esta maquina (nadie de blackbox lo hizo), pero nada lo
  # comprobaba. Nota honesta: kdump solo captura panics/oops donde el kernel
  # sigue vivo para hacer kexec -- un corte de energia real no pasa por aqui.
  # OJO: `kdump-config show | grep -q ...` se ve bien y esta MAL bajo
  # `set -o pipefail`: grep -q cierra su stdin en cuanto encuentra el primer
  # match, kdump-config recibe SIGPIPE y muere con rc=141 -- pipefail
  # propaga ESE 141, no el 0 de grep, y el chequeo decia FALTA con kdump
  # armado y corriendo. Medido 2026-09-09. Se evita el pipe: se captura la
  # salida completa primero.
  kdstate=""
  have kdump-config && kdstate=$(kdump-config show 2>/dev/null)
  case "$kdstate" in *"ready to kdump"*) kdok=0 ;; *) kdok=1 ;; esac
  chk "kdump (volcado de kernel ante panic, no ante corte de energia)" "$kdok" \
    "sudo kdump-config load -- captura panics/oops, no cortes de energia reales"

  echo
  echo "  armado: $armed    falta: $missing    ciego: $ciego"
  if [ "$ciego" -gt 0 ]; then
    echo "  OJO: 'ciego' no es 'armado'. Un instrumento ciego no deja el sujeto"
    echo "       limpio: deja el informe sin esa fila."
  fi
  local n; n=$(cat "$SAMPLES"/*.jsonl 2>/dev/null | wc -l)
  echo "  muestras acumuladas: $n"
  echo "  datos en: $DATA"
  [ "$missing" -gt 0 ] && echo && echo "  Con $missing piezas sin armar, un fallo puede volver a quedarse sin rastro."
  return 0
}

cmd_install() {
  local unitdir="$HOME/.config/systemd/user"
  mkdir -p "$unitdir"
  cp "$(dirname "$0")/../systemd/blackbox-sample.service" "$unitdir/"
  cp "$(dirname "$0")/../systemd/blackbox-sample.timer" "$unitdir/"
  systemctl --user daemon-reload
  systemctl --user enable --now blackbox-sample.timer
  echo "timer instalado. estado:"
  systemctl --user status blackbox-sample.timer --no-pager 2>&1 | head -5
}

# "Que procesos hay y QUIEN los llamo". El 2026-09-08 esa pregunta hubo que
# contestarla a mano tres veces (ollama con el cwd de un worktree borrado, el
# bucle de llama-server, y un python de 16 GB en la GPU), porque el muestreo
# guardaba RSS y nombre pero no el linaje.
#
# La respuesta buena en este sistema es el CGROUP: dice que unit de systemd
# contiene al proceso, y sobrevive a que el padre muera y lo adopte init --
# que es justo cuando el ppid deja de servir. Se dan los dos.
linaje() { # pid -> "unit | ppid comm_padre | cwd"
  local p="$1" unit ppid pcomm cwd
  unit=$(sed -n 's/^0::\///p' "/proc/$p/cgroup" 2>/dev/null | sed 's/.*\///')
  ppid=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  pcomm=$(ps -o comm= -p "${ppid:-0}" 2>/dev/null | tr -d ' ')
  cwd=$(readlink "/proc/$p/cwd" 2>/dev/null)
  case "$cwd" in *" (deleted)") cwd="$cwd  <-- CWD BORRADO" ;; esac
  echo "${unit:-?} | ppid=${ppid:-?} ${pcomm:-?} | ${cwd:-?}"
}

# `bb who` responde la pregunta para un pid, o para los que mas consumen.
cmd_who() {
  local objetivo="${1:-}"
  if [ -n "$objetivo" ]; then
    [ -d "/proc/$objetivo" ] || { echo "pid $objetivo no existe" >&2; return 1; }
    echo "== pid $objetivo =="
    echo "  cmd:    $(ps -o args= -p "$objetivo" 2>/dev/null | cut -c1-100)"
    echo "  linaje: $(linaje "$objetivo")"
    echo "  cadena de padres:"
    local p="$objetivo"
    for _ in 1 2 3 4 5 6; do
      p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
      [ -z "$p" ] || [ "$p" = "0" ] && break
      echo "    $p $(ps -o args= -p "$p" 2>/dev/null | cut -c1-80)"
      [ "$p" = "1" ] && break
    done
    return 0
  fi

  echo "== quien lanzo lo que mas consume =="
  echo
  echo "-- top por RSS --"
  ps -eo pid=,rss=,comm= --sort=-rss 2>/dev/null | head -6 | while read -r p rss comm; do
    printf "  %-8s %7.1f GB  %-18s %s\n" "$p" "$(echo "$rss/1048576" | bc -l)" "$comm" "$(linaje "$p")"
  done
  echo
  echo "-- procesos con memoria de GPU --"
  if have nvidia-smi; then
    nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader,nounits 2>/dev/null |
      while IFS=, read -r p mib; do
        p=$(echo "$p" | tr -d ' '); mib=$(echo "$mib" | tr -d ' ')
        [ -d "/proc/$p" ] || { echo "  $p (ya no existe) $mib MiB"; continue; }
        printf "  %-8s %7s MiB  %-18s %s\n" "$p" "$mib" \
          "$(ps -o comm= -p "$p" 2>/dev/null | tr -d ' ')" "$(linaje "$p")"
      done
  else
    echo "  nvidia-smi no disponible"
  fi
}

# Instalar systemd-coredump NO protege a lo que ya estaba corriendo: un proceso
# conserva de por vida el limite de core que heredo al arrancar. Medido el
# 2026-09-07: tras instalarlo, claude-desktop, ChatGPT y gnome-shell seguian los
# tres con core=0, o sea que un cuelgue no habria dejado volcado igual.
# `prlimit` lo cambia en caliente, sin reiniciar la app ni perder su estado
# (verificado: un proceso a 0 paso a unlimited y el kernel le genero el core).
cmd_protect() {
  local aplicados=0 fallidos=0 ya=0
  have prlimit || { echo "prlimit no disponible (paquete util-linux)" >&2; return 1; }

  # Se protege el ARBOL entero, no solo el proceso principal: en una app
  # Electron el que muere suele ser un renderizador, no el main.
  local raices
  raices=$(ps -eo pid=,args= 2>/dev/null | awk '/--type=zygote/{print $1}' |
    while read -r z; do ps -o ppid= -p "$z" 2>/dev/null | tr -d ' '; done | sort -u)

  for main in $raices; do
    [ -z "$main" ] && continue
    local exe; exe=$(readlink -f "/proc/$main/exe" 2>/dev/null) || continue
    [ -z "$exe" ] && continue
    echo "  $(basename "$exe") (pid $main):"
    # el main mas todo lo que cuelgue de el
    for p in $main $(pgrep -P "$main" 2>/dev/null) $(ps -eo pid=,args= 2>/dev/null |
                     awk -v e="$exe" '$2==e{print $1}'); do
      [ -d "/proc/$p" ] || continue
      local antes; antes=$(awk '/Max core file size/{print $5}' "/proc/$p/limits" 2>/dev/null)
      [ -z "$antes" ] && continue
      if [ "$antes" != "0" ]; then ya=$((ya + 1)); continue; fi
      if prlimit --core=unlimited --pid="$p" 2>/dev/null; then
        aplicados=$((aplicados + 1))
      else
        fallidos=$((fallidos + 1))
      fi
    done
  done
  echo
  echo "  protegidos ahora:   $aplicados"
  echo "  ya lo estaban:      $ya"
  echo "  no se pudo:         $fallidos"
  [ "$fallidos" -gt 0 ] && echo "  (los que fallan suelen ser de otro usuario o ya muertos)"
  echo
  echo "  Esto NO persiste: un relanzamiento de la app vuelve a heredar el"
  echo "  limite de su padre. Para que sea permanente hay que reabrir la"
  echo "  sesion grafica, cuyo gnome-shell ya nacera con el limite nuevo."
  return 0
}

# El repo es la fuente de verdad de lo adoptado, pero lo que CORRE es la copia
# desplegada. Si divergen en silencio, el repo documenta una maquina que no
# existe -- asi que la divergencia se mide, no se supone.
cmd_drift() {
  local root; root=$(cd "$(dirname "$0")/.." && pwd)
  local diverged=0 checked=0 missing=0 suspended=0

  suspension_caduca() { # ruta_desplegada -> imprime fecha de caducidad si esta suspendida
    local path="$1" manifest="$root/suspended/MANIFIESTO.md"
    [ -f "$manifest" ] || return 1
    local in_section=0 has_path=0 line caduca
    while IFS= read -r line; do
      case "$line" in
        "## "*) in_section=1; has_path=0 ;;
      esac
      [ "$in_section" = 1 ] || continue
      case "$line" in
        *"Ruta original"*"\`$path\`"*) has_path=1 ;;
      esac
      case "$line" in
        *"Caduca"*)
          [ "$has_path" = 1 ] || continue
          caduca=$(printf '%s' "$line" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | head -1)
          [ -n "$caduca" ] && { printf '%s\n' "$caduca"; return 0; }
          ;;
      esac
    done < "$manifest"
    return 1
  }

  cmp_one() { # origen_desplegado, copia_en_repo
    checked=$((checked + 1))
    if [ ! -e "$1" ]; then
      local caduca; caduca=$(suspension_caduca "$1") || true
      if [ -n "$caduca" ]; then
        local today; today=$(date +%F)
        if [[ "$today" > "$caduca" ]]; then
          echo "  VENCIDA     $1 (suspension en suspended/MANIFIESTO.md vencio $caduca -- revisar)"
          missing=$((missing + 1)); return
        fi
        echo "  SUSPENDIDO  $1 (documentado en suspended/MANIFIESTO.md, vence $caduca)"
        suspended=$((suspended + 1)); return
      fi
      echo "  AUSENTE     $1 (esta en el repo pero ya no en la maquina)"
      missing=$((missing + 1)); return
    fi
    if cmp -s "$1" "$2"; then
      echo "  igual       $1"
    else
      echo "  DIVERGE     $1"
      diff -u "$2" "$1" 2>/dev/null | head -12 | sed 's/^/                /'
      diverged=$((diverged + 1))
    fi
  }

  echo "== divergencia repo vs maquina =="
  for f in "$root"/adopted/gpu_governance/*.sh; do
    [ -e "$f" ] || continue
    cmp_one "/srv/ai/gpu_governance/$(basename "$f")" "$f"
  done
  for f in "$root"/adopted/systemd-user/*; do
    [ -e "$f" ] || continue
    cmp_one "$HOME/.config/systemd/user/$(basename "$f")" "$f"
  done
  for f in "$root"/adopted/system-config/*; do
    [ -e "$f" ] || continue
    cmp_one "/$(basename "$f" | tr _ /)" "$f"
  done

  echo
  echo "  revisados: $checked   divergentes: $diverged   ausentes: $missing   suspendidos: $suspended"
  [ $((diverged + missing)) -eq 0 ] && echo "  El repo describe la maquina que hay."
  return 0
}

# ------------------------------------------------------- DEBT-DGX-438
# Quien manda la senal que mata. `bb scan` compara muestras y ve que la
# victima DESAPARECIO; no ve quien la mato, porque la muestra se toma del
# lado de la victima y el emisor solo existe durante el syscall. El unico
# sitio de esta caja que guarda esa pareja es el registro de auditoria:
# auditd ya corre (active/enabled) y /var/log/audit es root:adm, asi que
# este usuario lo LEE sin root -- la misma dependencia de grupo que bb ya
# tiene para `journalctl -k`.
#
# La regla la instala `sudo ./enable-privileged.sh` (seccion 7). Sin ella
# auditd no registra un solo kill: medido 2026-09-23, 0 eventos de syscall
# kill en las 4 h 08 min que cubria el anillo.
AUDIT_DIR="${BLACKBOX_AUDIT_DIR:-/var/log/audit}"

cmd_sigterm() {
  local desde="${1:-2 hours ago}"
  local corte
  corte=$(date -d "$desde" +%s 2>/dev/null) || {
    echo "no entiendo la ventana: $desde" >&2; return 2; }

  echo "== emisores de SIGTERM/SIGKILL desde $desde =="
  echo

  # El parseo usa match(s, re, arr), que es extension de GNU awk. Aqui `awk`
  # es un symlink de alternatives a gawk 5.2.1 (verificado 2026-09-23), pero
  # si esa alternativa cambiara a mawk el tercer argumento se ignora y el
  # lector devolveria CERO FILAS sin un solo error -- que es la forma exacta
  # de mentir que este repo persigue. Se comprueba, no se supone.
  if ! echo "audit(1:2)" | awk 'match($0,/audit\(([0-9]+)/,m){exit m[1]==1?0:1} {exit 1}' 2>/dev/null; then
    cannot_run "lector de auditoria" "el awk de esta caja no soporta match(s,re,arr) (hace falta gawk); sin el, el parseo devolveria 0 filas en silencio"
    echo "  awk sin soporte de GNU match() -- NO se lee el registro"
    echo
    printf "could_not_run: %d\n%s" "$CNR" "$CNR_LIST"
    return 0
  fi

  if ! ls "$AUDIT_DIR"/audit.log >/dev/null 2>&1; then
    cannot_run "registro de auditoria" "$AUDIT_DIR/audit.log ilegible (hace falta grupo adm, o auditd no corre)"
    echo "  registro de auditoria ILEGIBLE -- sin el no hay emisor que leer"
    echo
    printf "could_not_run: %d\n%s" "$CNR" "$CNR_LIST"
    return 0
  fi

  # Distinguir "no hubo senales" de "el instrumento no esta armado" es la
  # mitad del valor de este subcomando: las dos salidas imprimen cero filas
  # y significan lo contrario. El discriminador NO es "cero eventos con mi
  # clave" -- eso es justo lo ambiguo. Es el efecto de la OTRA regla que
  # instala la misma seccion 7: la que calla el sondeo de rustdesk.
  #
  # La ventana de esa comprobacion es FIJA y corta, no la que pide el usuario.
  # Medido el 2026-09-23, y lo encontro el control negativo: recien instalada
  # la regla, `bb sigterm '5 minutes ago'` imprimio dos capturas reales y
  # debajo dijo NO ARMADO, porque en esos 5 minutos cabian 417 eventos de
  # ruido ANTERIORES a la instalacion. El instrumento estaba armado y
  # capturando, y su propia linea de estado lo desmentia.
  #
  # 30 s: el sondeo va a 1.9/s con solo el servicio root y a 14.6/s cuando
  # vive su hijo --server, o sea que 30 s de silencio son >=57 eventos que no
  # llegaron. Medido tras cargar la regla: 0 en 30 s, 408 en 60 s (los de
  # antes). Corta lo justo para no arrastrar el pasado y sobra para que el
  # cero signifique algo.
  local ruido armado_txt
  ruido=$(awk -v c="$(( $(date +%s) - 30 ))" '
    /^type=SYSCALL/ && /exe="\/usr\/bin\/loginctl"/ && /auid=4294967295/ {
      if (match($0, /audit\(([0-9]+)/, m) && m[1] >= c) n++
    } END { print n+0 }' "$AUDIT_DIR"/audit.log 2>/dev/null)
  ruido=${ruido:-0}
  # Tercer veredicto. El proxy necesita un SUJETO: si rustdesk no corre, nadie
  # esta generando el ruido que la regla calla, y entonces un cero no dice si
  # la regla esta puesta o si simplemente no habia nada que callar. Eso es
  # COULD_NOT_RUN, no "armado".
  local hay_sujeto=1
  pgrep -f "rustdesk" >/dev/null 2>&1 || hay_sujeto=0
  if [ "$ruido" -gt 0 ]; then
    armado_txt="NO ARMADO"
  elif [ "$hay_sujeto" = 0 ]; then
    armado_txt="NO SE PUDO DETERMINAR"
  else
    armado_txt="armado"
  fi

  local eventos
  eventos=$(awk -v c="$corte" '
    # Une el SYSCALL (emisor: pid/comm/exe/auid) con el OBJ_PID (victima:
    # opid/ocomm) por el id de evento audit(TS:SERIAL), que es lo unico que
    # los relaciona: auditd emite los dos registros por separado.
    match($0, /audit\(([0-9]+)\.[0-9]+:([0-9]+)\)/, m) {
      ts = m[1]; id = m[2]
      if (ts < c) next
      if ($0 ~ /^type=SYSCALL/ && $0 ~ /key="blackbox_sig/) {
        s_ts[id] = ts
        if (match($0, /[ ]pid=([0-9]+)/, x))  s_pid[id]  = x[1]
        if (match($0, /comm="([^"]*)"/, x))   s_comm[id] = x[1]
        if (match($0, /exe="([^"]*)"/, x))    s_exe[id]  = x[1]
        if (match($0, /auid=([0-9]+)/, x))    s_auid[id] = x[1]
        if (match($0, /key="([^"]*)"/, x))    s_key[id]  = x[1]
      }
      if ($0 ~ /^type=OBJ_PID/) {
        if (match($0, /opid=([0-9]+)/, x))    v_pid[id]  = x[1]
        if (match($0, /ocomm="([^"]*)"/, x))  v_comm[id] = x[1]
      }
    }
    END {
      for (id in s_ts) {
        sig = (s_key[id] == "blackbox_sigkill") ? "SIGKILL" : "SIGTERM"
        printf "%s.%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", s_ts[id], id, sig,
               s_pid[id], s_comm[id], s_exe[id], s_auid[id],
               (v_pid[id] == "" ? "?" : v_pid[id]),
               (v_comm[id] == "" ? "?" : v_comm[id])
      }
    }' "$AUDIT_DIR"/audit.log 2>/dev/null | sort -n)

  local n; n=$(printf "%s" "$eventos" | grep -c . || true)
  if [ "$n" -gt 0 ]; then
    printf "  %-19s %-8s %-22s -> %s\n" "CUANDO" "SENAL" "EMISOR" "VICTIMA"
    printf "%s\n" "$eventos" | while IFS=$'\t' read -r ts sig spid scomm sexe sauid vpid vcomm; do
      ts=${ts%%.*}
      local quien="demonio"
      [ "$sauid" != "4294967295" ] && quien="humano auid=$sauid"
      printf "  %-19s %-8s %-22s -> %s\n" \
        "$(date -d "@$ts" '+%Y-%m-%d %H:%M:%S')" "$sig" \
        "$scomm[$spid] $quien" "$vcomm[$vpid]"
      printf "  %-19s %-8s   exe: %s\n" "" "" "$sexe"
    done
    echo
    echo "  emisores distintos: $(printf "%s\n" "$eventos" | cut -f4 | sort -u | tr '\n' ' ')"
  else
    echo "  0 senales registradas en la ventana"
  fi

  echo
  echo "-- estado del instrumento --"
  echo "  regla de auditoria: $armado_txt"
  if [ "$ruido" -gt 0 ]; then
    cannot_run "regla de auditoria de senales" "no cargada: el sondeo de rustdesk sigue cayendo en el anillo ($ruido eventos en los ultimos 30s). Corre: sudo ./enable-privileged.sh"
    echo "            $ruido execve de loginctl con auid=unset en los ultimos 30s,"
    echo "            asi que la seccion 7 no esta cargada y un 0 de arriba NO"
    echo "            significa que nadie mando la senal: significa que nadie miraba."
  elif [ "$hay_sujeto" = 0 ]; then
    cannot_run "regla de auditoria de senales" "rustdesk no corre, asi que el proxy que comprueba la regla no tiene sujeto; usa 'sudo auditctl -l | grep blackbox_sig' para saberlo de verdad"
    echo "            rustdesk no corre, asi que nadie genera el ruido que la regla"
    echo "            calla y este cero no distingue 'regla puesta' de 'nada que callar'."
    echo "            Comprobalo directo:  sudo auditctl -l | grep blackbox_sig"
  fi
  echo
  printf "could_not_run: %d\n%s" "$CNR" "$CNR_LIST"
}

# ---------------------------------------------- techo por aplicacion
# Lanza un programa dentro de su PROPIO cgroup con techo de memoria. Si lo
# toca, el kernel mata DENTRO de ese cgroup y nadie mas se entera.
#
# Por que hace falta esto y no basta el techo de app.slice: ese cubre el slice
# ENTERO (48 GiB para todas las apps del escritorio juntas), asi que una sola
# aplicacion desbocada puede llevarse 40 GiB sin tocarlo y arrastrar al resto.
# Medido el 2026-09-24: el cuarto congelamiento consumio ~21 GB reales -- por
# debajo del techo del slice, o sea que no lo habria parado.
#
# Y por que SI funciona aqui, a diferencia del techo contra la memoria de GPU:
# medido el mismo dia, 3 GiB ordinarios TOCADOS suben memory.current en 2974
# MiB (el cgroup los ve), mientras que 7 GiB de CUDA solo suben 15 MiB (no los
# ve). Un IDE Electron usa memoria ordinaria: este techo si lo contiene.
cmd_cap() {
  local gb="${1:-}"; shift 2>/dev/null || true
  case "$gb" in
    ''|*[!0-9]*) echo "uso: bb cap <GB> <comando...>" >&2
                 echo "  ej: bb cap 16 /home/lcasarin/.local/share/antigravity-ide/antigravity" >&2
                 return 2 ;;
  esac
  [ $# -eq 0 ] && { echo "falta el comando" >&2; return 2; }

  local nom; nom="bb-cap-$(basename "$1" | tr -cd 'a-zA-Z0-9_-')-$$"
  echo "[bb cap] $1 bajo techo de ${gb}G (scope $nom)" >&2
  echo "[bb cap] si lo toca, el kernel mata SOLO lo que corre aqui dentro" >&2

  # --scope: el proceso hereda la terminal y las senales, que es lo que quiere
  # un lanzador de escritorio. MemorySwapMax evita que el techo se esquive
  # paginando: sin el, un proceso topado a 16G puede tener 16G mas en swap y
  # el sistema vuelve a sufrir el reclaim que este techo existe para evitar.
  systemd-run --user --scope --quiet --unit="$nom" \
    -p MemoryMax="${gb}G" -p MemorySwapMax="${gb}G" \
    -- "$@"
  local rc=$?

  # El pico se REPORTA para que el proximo numero salga de una medicion y no
  # de una corazonada. systemd lo conserva un rato tras salir el scope.
  local pico; pico=$(systemctl --user show "$nom.scope" -p MemoryPeak --value 2>/dev/null)
  case "$pico" in
    ''|'[not set]'|infinity) echo "[bb cap] pico: no disponible (el scope ya se recogio)" >&2 ;;
    *) awk -v p="$pico" -v g="$gb" 'BEGIN{
         printf "[bb cap] pico de memoria: %.1f GiB de %s permitidos (%.0f%% del techo)\n",
                p/1073741824, g"G", p*100/(g*1073741824) }' >&2 ;;
  esac
  [ "$rc" -eq 137 ] || [ "$rc" -eq 134 ] && \
    echo "[bb cap] salio con $rc: el kernel lo mato por el techo. Sube el numero o mira que pidio tanto." >&2
  return "$rc"
}

usage() {
  cat <<'USAGE'
bb -- caja negra de la maquina

  bb sample              una muestra de lo que nada mas cubre (apps, zombis)
  bb snapshot [razon]    volcado forense completo AHORA
  bb scan ["hace X"]     informe de fallos en una ventana (def: "2 hours ago")
  bb hw                  inventario de hardware y limites aplicados
  bb status              que instrumento esta armado y cual no
  bb drift               compara lo adoptado en el repo con lo desplegado
  bb protect             sube el limite de core de las apps ya corriendo (prlimit)
  bb who [pid]           que procesos pesan y QUIEN los lanzo (unit, padre, cwd)
  bb sigterm ["hace X"]  QUIEN mando SIGTERM/SIGKILL a quien (DEBT-DGX-438)
  bb cap <GB> <cmd...>   lanza algo con techo de memoria propio (el kernel lo aplica)
  bb install             instala el timer de usuario

Datos propios en ~/.local/share/blackbox (retencion 14 dias).
Fuentes de terceros que `bb scan` lee, no duplica:
  /srv/ai/logs/gpu/       telemetria de GPU cada 15s (gpu_sampler.sh)
  /srv/ai/logs/           memory_monitor.log cada 5 min
  /var/log/sysstat/       sar cada minuto
  journalctl              kernel, NVRM, segfaults
USAGE
}

case "${1:-}" in
  sample)   shift; cmd_sample "$@" ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  scan)     shift; cmd_scan "$@" ;;
  hw)       shift; cmd_hw "$@" ;;
  status)   shift; cmd_status "$@" ;;
  drift)    shift; cmd_drift "$@" ;;
  protect)  shift; cmd_protect "$@" ;;
  who)      shift; cmd_who "$@" ;;
  sigterm)  shift; cmd_sigterm "$@" ;;
  cap)      shift; cmd_cap "$@" ;;
  install)  shift; cmd_install "$@" ;;
  ""|-h|--help|help) usage ;;
  *) echo "subcomando desconocido: $1" >&2; usage >&2; exit 2 ;;
esac
