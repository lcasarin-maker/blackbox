 }
 
+/*
+ * bb-patch: on zero-FB chips (GB10) cudaMalloc arrives as NV01_MEMORY_SYSTEM, not as vidmem, so video_mem.c never
+ * charged it (measured 2026-10-12: dmem_prueba.sh rc 4, dmem.current 0 after a 256 MiB cudaMalloc, class 0x3e).
+ * Charge here, before the allocation, like vidmemConstruct does (615 video_mem.c:626-630); release on failure and
+ * in sysmemDestruct. The copy-construct path shares the source charge by reference count.
+ */
+NV_STATUS
+sysmemConstruct_IMPL
+(
+    SystemMemory *pSystemMemory,
+    CALL_CONTEXT *pCallContext,
+    RS_RES_ALLOC_PARAMS_INTERNAL *pParams
+)
+{
+    Memory *pMemory = staticCast(pSystemMemory, Memory);
+    OBJGPU *pGpu = pMemory->pGpu;
+    RmClient *pRmClient = dynamicCast(pCallContext->pClient, RmClient);
+    NV_MEMORY_ALLOCATION_PARAMS *pAllocData = pParams->pAllocParams;
+    NV_STATUS status;
+
+    if (RS_IS_COPY_CTOR(pParams))
+    {
+        Memory *pMemorySrc = dynamicCast(pParams->pSrcRef->pResource, Memory);
+
+        status = sysmemConstructInner(pSystemMemory, pCallContext, pParams);
+        if ((status == NV_OK) && (pMemorySrc != NULL))
+        {
+            pMemory->pCharge = pMemorySrc->pCharge;
+            memacctIncrementChargeRefCount(pMemory->pCharge);
+        }
+        return status;
+    }
+
+    if ((pRmClient != NULL) && !IS_MIG_ENABLED(pGpu))
+    {
+        NV_CHECK_OK_OR_RETURN(LEVEL_ERROR,
+            memacctTryCharge(pRmClient, pGpu->gpuId, pAllocData->size, &pMemory->pCharge));
+    }
+
+    status = sysmemConstructInner(pSystemMemory, pCallContext, pParams);
+    if ((status != NV_OK) && (pMemory->pCharge != NULL))
+    {
+        memacctReleaseCharge(pMemory->pCharge);
+        pMemory->pCharge = NULL;
+    }
+    return status;
+}
