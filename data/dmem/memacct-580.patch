new file mode 100644
index 0000000..b647adc
--- /dev/null
+++ b/src/nvidia/inc/kernel/mem_mgr/memacct.h
@@ -0,0 +1,60 @@
+ /*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: MIT
+ *
