 typedef NV_STATUS  NV_FORCERESULTCHECK OSAcquireRmSema(void *);
 typedef NvBool     NV_FORCERESULTCHECK OSIsRmSemaOwner(void *);
 typedef NV_STATUS  NV_FORCERESULTCHECK OSCondAcquireRmSema(void *);
