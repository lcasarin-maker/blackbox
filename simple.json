      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "scope": {
        "min_examined": 1
      }
    },
    {
      "id": "pyright",
      "policy": {
        "kind": "types",
        "python": "/usr/bin/python3",
        "args": [
          "--tool",
          "/home/lcasarin/.local/bin/pyright"
        ]
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUSERBASE": "/home/lcasarin/.local"
