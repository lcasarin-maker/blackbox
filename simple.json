    {
      "id": "pytest",
      "argv": [
        "sh",
        "-c",
        "\"$0\" -c 'import simplecode.verification.test_impact, xdist' || exit 2\n\"$0\" -m simplecode.verification.test_impact -q -n 4 --base \"$SIMPLE_BASE\" -m \"not slow and not e2e and not mutates_real_source\" --ignore=tests/test_bb_bash.py || exit $?\nexec \"$0\" -m simplecode.verification.test_impact -q --base \"$SIMPLE_BASE\" -m mutates_real_source",
        "/opt/miniforge3/bin/python3"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUSERBASE": "/home/lcasarin/.local"
      },
      "timeout_ms": 900000,
      "cache": false,
