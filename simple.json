{
  "version": 1,
  "checks": [
    {
      "id": "ruff",
      "argv": [
        "sh",
        "-c",
        "command -v \"$0\" >/dev/null 2>&1 || { echo \"COULD_NOT_RUN: ruff: no \\`$0\\` on PATH\" >&2; exit 2; }\ngit -c core.quotepath=false diff --raw --no-abbrev --no-renames --diff-filter=ACM HEAD^ HEAD -- ':(glob)**/*.gyp' ':(glob)**/*.gypi' ':(glob)**/*.ipynb' ':(glob)**/*.py' ':(glob)**/*.pyi' ':(glob)**/*.pyt' ':(glob)**/*.pyw' ':(glob)**/*.tac' ':(glob)**/*.wsgi' ':(glob)**/.pdbrc' ':(glob)**/wscript' > \"$TMPDIR/ruff.raw\" ||\n  { echo \"COULD_NOT_RUN: ruff: HEAD^..HEAD does not resolve (root commit)\" >&2; exit 2; }\nd=\"$TMPDIR/ruff-staged\"\ntab=$(printf '\\t')\nskipped=0\n: > \"$TMPDIR/ruff.list\"\nwhile IFS=' ' read -r _ mode _ sha rest; do\n  path=${rest#*\"$tab\"}\n  case $mode in 120000|160000) skipped=$((skipped+1)); continue ;; esac\n  mkdir -p \"$d/$(dirname -- \"$path\")\" && git cat-file blob \"$sha\" > \"$d/$path\" ||\n    { echo \"COULD_NOT_RUN: ruff: cannot read $path from HEAD\" >&2; exit 2; }\n  printf '%s\\n' \"$path\" >> \"$TMPDIR/ruff.list\"\ndone < \"$TMPDIR/ruff.raw\"\nset -f\nIFS='\n'\nset -- $(cat \"$TMPDIR/ruff.list\")\necho \"staged_range=HEAD^..HEAD python_files=$# links_skipped=$skipped\"\n[ \"$#\" -gt 0 ] || exit 0\ncd \"$d\" || exit 2\n\"$0\" check --isolated --no-cache --force-exclude --select E9,F821,F632,F811,B006,B017 --extend-select S102,S301,S602,S608,S307,S506,S604,S605,PLE2502,PLE2510,PLE2512,PLE2513,PLE2514,PLE2515 -- \"$@\" 2> \"$TMPDIR/ruff.err\"\nrc=$?\ncat \"$TMPDIR/ruff.err\" >&2\nif grep -q 'Failed to lint' \"$TMPDIR/ruff.err\"; then\n  echo \"COULD_NOT_RUN: ruff: a staged Python file was not linted\" >&2\n  exit 2\nfi\nexit $rc",
        "ruff"
      ],
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "simple.json"
      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        2
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "read_only": true,
      "hooks": [
        "pre-commit"
      ],
      "applies_to": [
        "**/*.gyp",
        "**/*.gypi",
        "**/*.ipynb",
        "**/*.py",
        "**/*.pyi",
        "**/*.pyt",
        "**/*.pyw",
        "**/*.tac",
        "**/*.wsgi",
        "**/.pdbrc",
        "**/wscript"
      ]
    },
    {
      "id": "gitleaks",
      "argv": [
        "sh",
        "-c",
        "n=$(git rev-list --count HEAD^..HEAD) ||\n  { echo \"COULD_NOT_RUN: gitleaks: HEAD^ does not resolve (root commit)\" >&2; exit 2; }\necho \"staged_range=HEAD^..HEAD range_commits=$n\"\nexec \"$0\" git --no-banner --redact --exit-code 23 --log-opts=\"HEAD^..HEAD\" .",
        "gitleaks"
      ],
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "simple.json",
        ".gitleaks.toml",
        ".gitleaksignore"
      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        1,
        2
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "read_only": true,
      "hooks": [
        "pre-commit"
      ],
      "applies_to": [
        "**"
      ]
    },
    {
      "id": "integridad-archivos",
      "policy": {
        "kind": "integrity",
        "python": "python3",
        "args": [
          "--staged",
          "--staged-base",
          "HEAD^"
        ]
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [],
      "read_only": true,
      "hooks": [
        "pre-commit"
      ]
    },
    {
      "id": "pii-staged",
      "policy": {
        "kind": "pii",
        "python": "python3",
        "args": [
          "--push",
          "--from-ref",
          "HEAD^",
          "--to-ref",
          "HEAD"
        ]
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [],
      "read_only": true,
      "hooks": [
        "pre-commit"
      ],
      "applies_to": [
        "tasks",
        "docs"
      ]
    },
    {
      "id": "bash-sintaxis",
      "argv": [
        "sh",
        "-c",
        "files=$(git diff --name-only --diff-filter=ACMR HEAD^ HEAD -- bin/bb '*.sh') ||\n  { echo \"COULD_NOT_RUN: bash-sintaxis: HEAD^ does not resolve (root commit)\" >&2; exit 2; }\nn=0; bad=0\nfor f in $files; do\n  n=$((n+1))\n  bash -n -- \"$f\" || { bad=$((bad+1)); echo \"syntax error: $f\" >&2; }\ndone\necho \"staged_range=HEAD^..HEAD bash_files=$n bad=$bad\"\n[ \"$bad\" -eq 0 ]"
      ],
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        2
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "read_only": true,
      "hooks": [
        "pre-commit"
      ],
      "applies_to": [
        "bin/bb",
        "**/*.sh"
      ]
    },
    {
      "id": "inventario-spec",
      "argv": [
        "python3",
        "-m",
        "tools.inventario",
        "--check"
      ],
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": false,
      "could_not_run_exit_codes": [],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "read_only": true,
      "hooks": [
        "pre-commit"
      ]
    },
    {
      "id": "datos-privados-publicacion",
      "argv": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "-p",
        "no:cacheprovider",
        "tests/test_sin_datos_privados.py"
      ],
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        2,
        3,
        4,
        5
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "read_only": true,
      "hooks": [
        "pre-push"
      ]
    },
    {
      "id": "pytest",
      "policy": {
        "kind": "test-impact",
        "python": "python3",
        "args": [
          "--tests-dir",
          "tests",
          "--runner",
          "python3",
          "-m",
          "pytest",
          "-q",
          "-m",
          "not slow and not e2e"
        ]
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "timeout_ms": 900000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        2
      ],
      "base": "origin/master",
      "inherit_env": [
        "XDG_RUNTIME_DIR",
        "DBUS_SESSION_BUS_ADDRESS"
      ],
      "hooks": [
        "pre-push"
      ]
    },
    {
      "id": "bb-cobertura-piso",
      "argv": [
        "sh",
        "-c",
        "tools/piso_cobertura.sh 2> \"$TMPDIR/piso.err\"; rc=$?\ncat \"$TMPDIR/piso.err\" >&2\nif [ \"$rc\" -eq 2 ] && grep -q 'COULD_NOT_RUN: suite fallo (exit 1)' \"$TMPDIR/piso.err\"; then\n  echo \"[bb-cobertura] FAIL: tests/test_bb_bash.py fails: bin/bb no longer does what its suite checks\" >&2\n  exit 1\nfi\nexit $rc"
      ],
      "timeout_ms": 900000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        2
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "inherit_env": [
        "XDG_RUNTIME_DIR",
        "DBUS_SESSION_BUS_ADDRESS"
      ],
      "hooks": [
        "pre-push"
      ],
      "applies_to": [
        "bin/bb",
        "tests/test_bb_bash.py"
      ]
    },
    {
      "id": "ceremony",
      "policy": {
        "kind": "ceremony",
        "python": "python3",
        "args": []
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "simple.json"
      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        2
      ],
      "base": "origin/master",
      "read_only": true,
      "hooks": [
        "pre-push"
      ]
    },
    {
      "id": "close-check",
      "policy": {
        "kind": "close-check",
        "python": "python3",
        "args": [
          "--enforce"
        ]
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "simple.json"
      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        2
      ],
      "base": "origin/master",
      "read_only": true,
      "hooks": [
        "pre-push"
      ]
    },
    {
      "id": "ruff-full",
      "argv": [
        "sh",
        "-c",
        "command -v \"$0\" >/dev/null 2>&1 || { echo \"COULD_NOT_RUN: ruff-full: no \\`$0\\` on PATH\" >&2; exit 2; }\nexec \"$0\" check --no-cache \"$@\" .",
        "ruff",
        "--extend-select",
        "S102,S301,S602,S608,S307,S506,S604,S605,PLE2502,PLE2510,PLE2512,PLE2513,PLE2514,PLE2515"
      ],
      "timeout_ms": 1800000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": false,
      "could_not_run_exit_codes": [
        2
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "read_only": true,
      "hooks": [
        "ci"
      ]
    },
    {
      "id": "pyright",
      "policy": {
        "kind": "types",
        "python": "python3",
        "args": []
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "timeout_ms": 1800000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [],
      "inherit_env": [
        "PYTHONUSERBASE"
      ],
      "read_only": true,
      "hooks": [
        "ci"
      ]
    },
    {
      "id": "gitleaks-history",
      "argv": [
        "sh",
        "-c",
        "n=$(git rev-list --all --count) || { echo \"COULD_NOT_RUN: gitleaks-history: git rev-list --all failed\" >&2; exit 2; }\n[ \"$n\" -gt 0 ] || { echo \"COULD_NOT_RUN: gitleaks-history: no commit enumerated (git-history-present)\" >&2; exit 2; }\n[ \"$(git rev-parse --is-shallow-repository)\" = false ] ||\n  { echo \"COULD_NOT_RUN: gitleaks-history: shallow history cannot cover every commit\" >&2; exit 2; }\necho \"history=--all reachable_commits=$n\"\nexec \"$0\" git --no-banner --redact --exit-code 23 --log-opts=--all \"$@\" .",
        "gitleaks"
      ],
      "timeout_ms": 1800000,
      "cache": false,
      "inputs": [
        "simple.json",
        ".gitleaks.toml",
        ".gitleaksignore"
      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        1,
        2
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "read_only": true,
      "hooks": [
        "ci"
      ]
    },
    {
      "id": "integridad-arbol",
      "policy": {
        "kind": "integrity",
        "python": "python3",
        "args": []
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "timeout_ms": 1800000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [],
      "read_only": true,
      "hooks": [
        "ci"
      ]
    },
    {
      "id": "pii-arbol",
      "policy": {
        "kind": "pii",
        "python": "python3",
        "args": [
          "--all-tracked"
        ]
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "timeout_ms": 1800000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [],
      "read_only": true,
      "hooks": [
        "ci"
      ]
    }
  ]
}
