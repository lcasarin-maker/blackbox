      ],
      "git_context": true,
      "could_not_run_exit_codes": [
        2
      ],
      "hooks": [
        "pre-push"
      ],
      "base": "origin/master",
      "inherit_env": [
        "XDG_RUNTIME_DIR",
        "DBUS_SESSION_BUS_ADDRESS"
      ]
    },
    {
      "id": "bash-sintaxis",
      "argv": [
        "sh",
        "-c",
        "n=0; bad=0\nfor f in $(git ls-files | grep -E '^(bin/bb|.*\\.sh)$'); do\n  n=$((n+1))\n  bash -n -- \"$f\" || { bad=$((bad+1)); echo \"syntax error: $f\" >&2; }\ndone\nprintf '{\"examined\":%s}' \"$n\" > \"$SIMPLE_SCOPE_FILE\"\necho \"bash_files=$n bad=$bad\"\n[ \"$bad\" -eq 0 ]"
      ],
      "timeout_ms": 300000,
      "cache": false,
      "inputs": [
        "."
      ],
      "git_context": true,
      "could_not_run_exit_codes": [],
      "hooks": [
        "pre-commit",
        "pre-push"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "scope": {
        "min_examined": 1
      }
    },
    {
      "id": "bb-cobertura-piso",
      "argv": [
        "sh",
        "-c",
        "if ! git diff --name-only \"$SIMPLE_BASE..HEAD\" | grep -qE '^bin/bb$|^tests/test_bb_bash.py$'; then\n  echo \"[bb-cobertura] bin/bb y tests/test_bb_bash.py sin cambios en $SIMPLE_BASE..HEAD; piso retenido, no medido\"\n  printf '{\"examined\":0}' > \"$SIMPLE_SCOPE_FILE\"\n  exit 0\nfi\nprintf '{\"examined\":1}' > \"$SIMPLE_SCOPE_FILE\"\nexec tools/piso_cobertura.sh"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUSERBASE": "/home/lcasarin/.local"
      },
      "timeout_ms": 900000,
      "cache": false,
