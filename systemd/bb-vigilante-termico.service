[Unit]
Description=bb guardia termico predictivo (interruptor termico_predictivo; off por defecto)

[Service]
Type=simple
WorkingDirectory=%h/projects/blackbox
ExecStart=/usr/bin/python3 -m tools.guardia_termico_predictivo
ExecStopPost=-%h/projects/blackbox/bin/bb-parada-diagnostico %n $EXIT_STATUS $SERVICE_RESULT
Restart=on-failure
MemoryMax=128M

[Install]
WantedBy=default.target
