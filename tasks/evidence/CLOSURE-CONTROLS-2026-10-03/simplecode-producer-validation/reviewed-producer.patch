+def test_insecure_defaults_classifies_assignment_ast_and_keeps_parse_fallback():
+    for source in (
+        "verify = False\n",
+        'origins = "*"\n',
+        'host = "0.0.0.0"\n',
+    ):
+        assert pattern_detectors.insecure_defaults(source), source
+    assert not pattern_detectors.insecure_defaults("verify = True\n")
+    assert pattern_detectors.insecure_defaults("def incomplete(\nverify=False")
+    for source in (
+        "client.verify = False\n",
+        'settings.host = "0.0.0.0"\n',
+        'client.origins: str = "*"\n',
+        "def request(*, verify=False):\n    pass\n",
+        "def request(verify: bool = False):\n    pass\n",
+        'requests.get(url, verify=False)\n',
+        'CORS(app, origins="*")\n',
+        "hashlib.md5(data)\n",
+        'app.run(host="0.0.0.0")\n',
+    ):
+        assert pattern_detectors.insecure_defaults(source), source
+    assert not pattern_detectors.insecure_defaults('rules = ("verify=False",)\n')
+
