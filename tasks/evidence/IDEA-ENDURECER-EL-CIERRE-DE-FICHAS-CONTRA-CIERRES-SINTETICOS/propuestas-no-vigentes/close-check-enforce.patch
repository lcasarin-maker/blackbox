@@ -0,0 +1,45 @@
+"""Opt-in blocking, real fixture execution, and a broken instrument through real Git."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'policy'))
+from simple_policy import close_check_lint as detector
+
+
+def card(command):
+    import json
+    return '---\nid: X\nstatus: done\nclose_check: '+json.dumps({'cmd': command})+'\n---\n'
+
+
+def test_closed_card_without_executor_blocks(tmp_path, capsys):
+    (tmp_path / 'tasks').mkdir()
+    (tmp_path / 'tasks/X.md').write_text(card('test -f receipt.json'))
+    assert detector.main(['--root',str(tmp_path),'--all','--enforce']) == 1
+    assert 'fichas_cerradas=1 ejecuta=0 no_ejecuta=1' in capsys.readouterr().out
+
+
+def test_real_product_fixture_passes(tmp_path):
+    (tmp_path/'tasks').mkdir()
+    (tmp_path/'product.py').write_text("from pathlib import Path\nPath('ran').write_text('producto ejecutado')\n")
+    subprocess.run([sys.executable,'product.py'],cwd=tmp_path,check=True)
+    assert (tmp_path/'ran').read_text() == 'producto ejecutado'
+    (tmp_path/'tasks/X.md').write_text(card('python3 product.py'))
+    assert detector.main(['--root',str(tmp_path),'--all','--enforce']) == 0
+
+
+def test_absent_git_is_could_not_run(tmp_path,monkeypatch,capsys):
+    monkeypatch.setenv('PATH',str(tmp_path/'sin_binarios'))
+    assert detector.main(['--root',str(tmp_path),'--base','HEAD^','--head','HEAD','--enforce']) == 2
+    assert 'COULD_NOT_RUN' in capsys.readouterr().err
+
+
+def test_detector_removed_breaks_negative_control(tmp_path,monkeypatch):
+    (tmp_path/'tasks').mkdir()
+    (tmp_path/'tasks/X.md').write_text(card('test -f receipt.json'))
+    monkeypatch.setattr(detector,'classify',lambda _: ('ejecuta','detector neutralizado'))
+    with pytest.raises(AssertionError):
+        assert detector.main(['--root',str(tmp_path),'--all','--enforce']) == 1
