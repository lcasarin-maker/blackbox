#!/bin/sh
# simplecode-fleet-launcher v1
set -eu
root=$(git rev-parse --show-toplevel) || exit 2
kit="$root/.simplecode/kit"
expected="a8853293a91a8cecac596b21dd5d46742fc86273"
actual=$(git -C "$kit" rev-parse HEAD) || { echo "COULD_NOT_RUN: Simplecode kit is unavailable" >&2; exit 2; }
test "$actual" = "$expected" || { echo "COULD_NOT_RUN: Simplecode kit SHA differs from pinned ref" >&2; exit 2; }
exec "$kit/.venv/bin/python" -m simplecode.fleet_runner --root "$root" "$@"
